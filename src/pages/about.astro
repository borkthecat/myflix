          </div>
          <div class="horizontal-word" data-image="/images/user2.jpg">
            <span>Code</span>
            <div class="hover-image"></div>
          </div>
          <div class="horizontal-word" data-image="/images/user3.jpg">
            <span>Create</span>
            <div class="hover-image"></div>
          </div>
          <div class="horizontal-word" data-image="/images/user4.jpg">
            <span>Innovate</span>
