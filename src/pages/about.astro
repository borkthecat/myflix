<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About Me - MyFlix</title>
    <link rel="stylesheet" href="/styles/about.css" />
  </head>

  <body>
    <!-- Navbar -->
    <header class="navbar">
      <div class="navbar-left">
        <img src="/images/logo.png" alt="MyFlix Logo" class="logo" />
        <nav class="nav-links">
          <a href="/home">Home</a>
          <a href="/about">About Me</a>
          <a href="/home#skills">Skills</a>
          <a href="/home#languages">Languages</a>
          <a href="/home#projects">Projects</a>
        </nav>
        <div class="browse-menu">
          <button class="browse-btn">Browse</button>
          <div class="browse-list">
            <a href="/home">Home</a>
            <a href="/about">About Me</a>
            <a href="/home#skills">Skills</a>
            <a href="/home#languages">Languages</a>
            <a href="/home#projects">Projects</a>
          </div>
        </div>
      </div>
      <div class="navbar-right">
        <div class="search-wrapper">
          <input
            type="text"
            class="search-input"
            placeholder="Search site..."
          />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="icon search-toggle"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M10 2a8 8 0 015.292 13.708l4 4a1 1 0 01-1.414 1.414l-4-4A8 8 0 1110 2zm-6 8a6 6 0 1110.416 4.243A6 6 0 014 10z"
            ></path>
          </svg>
        </div>
        <img src="/images/user1.jpg" alt="Profile" class="avatar" />
      </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
      <!-- Hero Section -->
      <section class="about-hero">
        <div class="hero-text-content">
          <h1 class="hero-title">Arai Nanami Rachel</h1>
          <p class="hero-subtitle">Computer Science & Design Student</p>
          <p class="hero-description">
            Undergraduate at SUTD studying Computer Science and Design, with a
            curiosity for technology and how it shapes the world. Passionate
            about creating innovative solutions that bridge the gap between
            design and engineering.
          </p>
          <div class="hero-buttons">
            <a href="/resume.pdf" class="btn btn-primary" download target="_blank">
              <img src="/icons/play.svg" alt="Resume" class="btn-icon" />
              Download Resume
            </a>
            <a href="mailto:contact@example.com" class="btn btn-secondary">
              <img src="/icons/mail.svg" alt="Email" class="btn-icon" />
              Get in Touch
            </a>
          </div>
        </div>
      </section>

      <!-- Story Section -->
      <section class="story-section">
        <h2 class="section-title">My Journey</h2>
        <div class="story-timeline">
          <div class="timeline-card">
            <div class="timeline-number">01</div>
            <div class="timeline-content">
              <h3>Education</h3>
              <p>
                Currently pursuing my undergraduate degree at SUTD, where I'm
                studying Computer Science and Design. This unique combination
                allows me to bridge the gap between technical excellence and
                creative problem-solving.
              </p>
            </div>
          </div>
          <div class="timeline-card">
            <div class="timeline-number">02</div>
            <div class="timeline-content">
              <h3>Passion</h3>
              <p>
                I'm deeply curious about how technology shapes our world and
                impacts human experiences. My passion lies in creating innovative
                solutions that are both technically sound and beautifully
                designed.
              </p>
            </div>
          </div>
          <div class="timeline-card">
            <div class="timeline-number">03</div>
            <div class="timeline-content">
              <h3>Goals</h3>
              <p>
                My goal is to work on projects that make a real difference,
                whether through user experience design, software development, or
                exploring the intersection of AI and creative technologies.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Interests Section -->
      <section class="interests-section">
        <h2 class="section-title">Beyond the Screen</h2>
        <div class="interests-mosaic">
          <div class="mosaic-item mosaic-large">
            <div class="mosaic-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6.5 6.5h11v11h-11z"></path>
                <path d="M6.5 6.5l5.5 5.5 5.5-5.5"></path>
                <path d="M12 12v6"></path>
              </svg>
            </div>
            <h3>Fitness & Wellness</h3>
            <p>
              The gym is my sanctuary. It's where I recharge, stay focused,
              and maintain balance. Physical fitness keeps my mind sharp and
              ready for the next challenge.
            </p>
          </div>
          <div class="mosaic-item">
            <div class="mosaic-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 18V5l12-2v13"></path>
                <circle cx="6" cy="18" r="3"></circle>
                <circle cx="18" cy="16" r="3"></circle>
              </svg>
            </div>
            <h3>Music</h3>
            <p>
              Music is my constant companion. Whether I'm coding, designing, or
              just reflecting, the right soundtrack helps me find flow and
              inspiration.
            </p>
          </div>
          <div class="mosaic-item">
            <div class="mosaic-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <h3>Experimentation</h3>
            <p>
              I love learning by doing. Experimenting with new technologies,
              trying different approaches, and turning ideas into reality is
              what drives me forward.
            </p>
          </div>
        </div>
      </section>

      <!-- Philosophy Section -->
      <section class="philosophy-section">
        <div class="philosophy-content">
          <h2 class="philosophy-title">My Philosophy</h2>
          <p class="philosophy-text">
            I believe in the power of learning, experimenting, and finding ways
            to turn ideas into something real and impactful. Every project is an
            opportunity to push boundaries, solve problems, and create something
            meaningful. Whether it's through elegant code, intuitive design, or
            innovative solutions, I strive to make a difference.
          </p>
          <div class="philosophy-highlights">
            <div class="highlight">
              <span class="highlight-number">100+</span>
              <span class="highlight-label">Projects</span>
            </div>
            <div class="highlight">
              <span class="highlight-number">50+</span>
              <span class="highlight-label">Technologies</span>
            </div>
            <div class="highlight">
              <span class="highlight-number">∞</span>
              <span class="highlight-label">Curiosity</span>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-container">
        <div class="socials">
          <a href="mailto:contact@example.com">
            <img src="/icons/mail.svg" alt="Email" />
          </a>
          <a href="#">
            <img src="/icons/instagram.svg" alt="Instagram" />
          </a>
          <a href="#">
            <img src="/icons/contact.svg" alt="Contact" />
          </a>
        </div>
        <div class="copyright">
          © <span id="year"></span> Arai Nanami Rachel. All rights reserved.
        </div>
      </div>
    </footer>

    <script>
      document.getElementById("year").textContent = new Date().getFullYear();

      window.addEventListener("scroll", () => {
        const navbar = document.querySelector(".navbar");
        if (window.scrollY > 50) {
          navbar.classList.add("scrolled");
        } else {
          navbar.classList.remove("scrolled");
        }
      });

      const searchWrapper = document.querySelector(".search-wrapper");
      const searchToggle = document.querySelector(".search-toggle");
      const searchInput = document.querySelector(".search-input");

      if (searchToggle) {
        searchToggle.addEventListener("click", () => {
          searchWrapper.classList.toggle("active");
          if (searchWrapper.classList.contains("active")) {
            searchInput.focus();
          }
        });
      }

      document.addEventListener("click", (e) => {
        if (searchWrapper && !searchWrapper.contains(e.target)) {
          searchWrapper.classList.remove("active");
        }
      });

      document.addEventListener("DOMContentLoaded", () => {
        const browseMenu = document.querySelector(".browse-menu");
        const browseBtn = document.querySelector(".browse-btn");

        if (browseBtn) {
          browseBtn.addEventListener("click", () => {
            browseMenu.classList.toggle("active");
          });

          document.addEventListener("click", (e) => {
            if (browseMenu && !browseMenu.contains(e.target)) {
              browseMenu.classList.remove("active");
            }
          });
        }
      });
    </script>
  </body>
</html>
