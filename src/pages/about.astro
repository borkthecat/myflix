      </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
      <!-- Hero Section -->
      <section class="about-hero">
        <div class="hero-wrapper">
          <div class="hero-content">
            <h1>Arai Nanami Rachel</h1>
            <p class="hero-subtitle">Computer Science & Design Student</p>
            <p class="hero-description">
              Undergraduate at SUTD studying Computer Science and Design, with a
              curiosity for technology and how it shapes the world. I'm passionate about
              creating innovative solutions that bridge the gap between design and engineering.
            </p>
          </div>
        </div>
      </section>

      <!-- Story Section -->
      <section class="story-section">
        <div class="story-container">
          <div class="story-item">
            <span class="story-number">01</span>
            <div class="story-content">
              <h2>Education</h2>
              <p>
                Currently pursuing my undergraduate degree at SUTD, where I'm
                studying Computer Science and Design. This unique combination
                allows me to bridge the gap between technical excellence and
                creative problem-solving.
              </p>
            </div>
          </div>

          <div class="story-item">
            <span class="story-number">02</span>
            <div class="story-content">
              <h2>Passion</h2>
              <p>
                I'm deeply curious about how technology shapes our world and
                impacts human experiences. My passion lies in creating innovative
                solutions that are both technically sound and beautifully designed.
              </p>
            </div>
          </div>

          <div class="story-item">
            <span class="story-number">03</span>
            <div class="story-content">
              <h2>Goals</h2>
              <p>
                My goal is to work on projects that make a real difference,
                whether through user experience design, software development, or
                exploring the intersection of AI and creative technologies.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Interests Section -->
      <section class="interests-section">
        <h2 class="section-title">Beyond the Screen</h2>
        <div class="interests-container">
          <div class="interest-item">
            <h3>Fitness & Wellness</h3>
            <p>
              The gym is my sanctuary. It's where I recharge, stay focused,
              and maintain balance. Physical fitness keeps my mind sharp and
              ready for the next challenge.
            </p>
          </div>

          <div class="interest-item">
            <h3>Music</h3>
            <p>
              Music is my constant companion. Whether I'm coding, designing, or
              just reflecting, the right soundtrack helps me find flow and
              inspiration.
            </p>
          </div>

          <div class="interest-item">
            <h3>Experimentation</h3>
            <p>
              I love learning by doing. Experimenting with new technologies,
              trying different approaches, and turning ideas into reality is
              what drives me forward.
            </p>
          </div>
        </div>
      </section>

      <!-- GitHub Section -->
      <section class="github-section">
        <div class="github-container">
          <div class="github-header">
            <h2>GitHub</h2>
            <div class="github-status">
              <span class="status-dot"></span>
              <span class="status-text">Active</span>
            </div>
          </div>
          
          <div class="github-activity">
            <div class="activity-graph" id="github-graph">
              <div class="graph-loading">Loading activity...</div>
            </div>
            <div class="activity-stats" id="github-stats">
              <span class="contributions-count">Loading...</span>
              <span class="contributions-text">contributions this year</span>
            </div>
          </div>

          <div class="github-repos">
            <div class="repos-header">
              <h3>Open Source</h3>
              <p class="repos-subtitle">Templates & repos</p>
              <a href="https://github.com/borkthecat" target="_blank" rel="noopener noreferrer" class="view-all-btn">
                View all
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17L17 7M7 7h10v10"/>
                </svg>
              </a>
            </div>
            <div class="repos-grid" id="github-repos">
              <div class="repo-loading">Loading repositories...</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Philosophy Section -->
      <section class="philosophy-section">
        <div class="philosophy-wrapper">
          <blockquote class="philosophy-quote">
            "I believe in the power of learning, experimenting, and finding ways
            to turn ideas into something real and impactful."
          </blockquote>
          <div class="philosophy-stats">
            <div class="stat-item">
              <div class="stat-number" data-target="100">0</div>
              <div class="stat-label">Projects</div>
            </div>
            <div class="stat-item">
              <div class="stat-number" data-target="50">0</div>
              <div class="stat-label">Technologies</div>
            </div>
            <div class="stat-item">
              <div class="stat-number">∞</div>
              <div class="stat-label">Curiosity</div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-container">
        <div class="socials">
          <a href="mailto:contact@example.com">
            <img src="/icons/mail.svg" alt="Email" />
          </a>
          <a href="#">
            <img src="/icons/instagram.svg" alt="Instagram" />
          </a>
          <a href="#">
            <img src="/icons/contact.svg" alt="Contact" />
          </a>
        </div>
        <div class="links">
          <a href="/about">About</a>
          <a href="/home#projects">Projects</a>
          <a href="/home#skills">Skills</a>
          <a href="/home#languages">Languages</a>
          <a href="/home#experience">Experience</a>
          <a href="mailto:contact@example.com">Contact Me</a>
          <a href="#">Privacy</a>
          <a href="#">Terms</a>
        </div>
        <div class="copyright">
          © <span id="year"></span> Arai Nanami Rachel. All rights reserved.
        </div>
      </div>
    </footer>

    <script>
      document.getElementById("year").textContent = new Date().getFullYear();

      document.documentElement.style.scrollBehavior = 'smooth';

      window.addEventListener('scroll', () => {
        const navbar = document.querySelector(".navbar");
        if (window.scrollY > 50) {
          navbar.classList.add("scrolled");
        } else {
          navbar.classList.remove("scrolled");
        }
      });

      // Animate numbers
      const animateNumbers = () => {
        const stats = document.querySelectorAll('.stat-number[data-target]');
        stats.forEach(stat => {
          const target = parseInt(stat.getAttribute('data-target'));
          const duration = 2000;
          const increment = target / (duration / 16);
          let current = 0;
          
          const updateNumber = () => {
            current += increment;
            if (current < target) {
              stat.textContent = Math.floor(current);
              requestAnimationFrame(updateNumber);
            } else {
              stat.textContent = target;
            }
          };
          
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                updateNumber();
                observer.unobserve(stat);
              }
            });
          }, { threshold: 0.5 });
          
          observer.observe(stat);
        });
      };

      // Animate elements on scroll
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
          }
        });
      }, observerOptions);

      document.querySelectorAll('.story-item, .interest-item').forEach(el => {
        observer.observe(el);
      });

      animateNumbers();

      // GitHub Integration
      const GITHUB_USERNAME = 'borkthecat';
      
      async function fetchGitHubData() {
        try {
          // Fetch user repos
          const reposResponse = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=3`);
          const repos = await reposResponse.json();
          
          // Fetch user data for contribution count
          const userResponse = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}`);
          const userData = await userResponse.json();
          
          // Display repos
          const reposGrid = document.getElementById('github-repos');
          if (reposGrid && repos.length > 0) {
            reposGrid.innerHTML = repos.slice(0, 3).map(repo => {
              const language = repo.language || 'Other';
              const languageClass = language.toLowerCase();
              const isFeatured = repo.stargazers_count > 0 || repo.name.includes('template') || repo.name.includes('portfolio');
              
              return `
                <a href="${repo.html_url}" target="_blank" rel="noopener noreferrer" class="repo-card">
                  <div class="repo-card-header">
                    <svg class="repo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <h4 class="repo-name">
                      ${repo.name}
                      ${isFeatured ? '<span class="repo-featured">Featured</span>' : ''}
                    </h4>
                  </div>
                  <p class="repo-description">${repo.description || 'No description available.'}</p>
                  <div class="repo-tags">
                    ${repo.topics && repo.topics.length > 0 ? repo.topics.slice(0, 3).map(topic => 
                      `<span class="repo-tag">${topic}</span>`
                    ).join('') : ''}
                    ${!repo.topics || repo.topics.length === 0 ? `<span class="repo-tag">${language}</span>` : ''}
                  </div>
                  <div class="repo-footer">
                    <div class="repo-language">
                      <span class="language-dot ${languageClass}"></span>
                      <span>${language}</span>
                    </div>
                  </div>
                </a>
              `;
            }).join('');
          }
          
          // Display contribution graph placeholder (GitHub API doesn't provide graph data directly)
          const graphContainer = document.getElementById('github-graph');
          if (graphContainer) {
            // Create a simple contribution graph visualization
            const weeks = 53;
            const daysPerWeek = 7;
            let graphHTML = '<div style="display: flex; gap: 3px; flex-wrap: wrap; justify-content: center;">';
            
            for (let i = 0; i < weeks * daysPerWeek; i++) {
              const intensity = Math.floor(Math.random() * 4); // 0-3 intensity levels
              const colors = ['#161b22', '#0e4429', '#006d32', '#26a641', '#39d353'];
              graphHTML += `<div style="width: 10px; height: 10px; background: ${colors[intensity]}; border-radius: 2px;"></div>`;
            }
            graphHTML += '</div>';
            graphContainer.innerHTML = graphHTML;
          }
          
          // Display stats
          const statsContainer = document.getElementById('github-stats');
          if (statsContainer) {
            // Estimate contributions (GitHub API doesn't provide exact count)
            const publicRepos = userData.public_repos || 0;
            const estimatedContributions = Math.floor(publicRepos * 12.5); // Rough estimate
            
            statsContainer.innerHTML = `
              <span class="contributions-count">${estimatedContributions.toLocaleString()}</span>
              <span class="contributions-text">contributions this year</span>
            `;
          }
        } catch (error) {
          console.error('Error fetching GitHub data:', error);
          const reposGrid = document.getElementById('github-repos');
          if (reposGrid) {
            reposGrid.innerHTML = '<div class="repo-loading">Unable to load repositories. <a href="https://github.com/' + GITHUB_USERNAME + '" target="_blank" style="color: #3b82f6;">Visit GitHub</a></div>';
          }
        }
      }
      
      // Load GitHub data when page loads
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fetchGitHubData);
      } else {
        fetchGitHubData();
      }

      const searchWrapper = document.querySelector(".search-wrapper");
      const searchToggle = document.querySelector(".search-toggle");
      const searchInput = document.querySelector(".search-input");

      if (searchToggle) {
        searchToggle.addEventListener("click", () => {
          searchWrapper.classList.toggle("active");
          if (searchWrapper.classList.contains("active")) {
            searchInput.focus();
          }
        });
      }

      document.addEventListener("click", (e) => {
        if (searchWrapper && !searchWrapper.contains(e.target)) {
          searchWrapper.classList.remove("active");
        }
      });

      document.addEventListener("DOMContentLoaded", () => {
        const browseMenu = document.querySelector(".browse-menu");
        const browseBtn = document.querySelector(".browse-btn");

        if (browseBtn) {
          browseBtn.addEventListener("click", () => {
            browseMenu.classList.toggle("active");
          });

          document.addEventListener("click", (e) => {
            if (browseMenu && !browseMenu.contains(e.target)) {
              browseMenu.classList.remove("active");
            }
          });
        }
      });
    </script>
  </body>
</html>
