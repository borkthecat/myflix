    <script>
      document.getElementById("year").textContent = new Date().getFullYear();

      document.documentElement.style.scrollBehavior = 'smooth';

      window.addEventListener('scroll', () => {
        const navbar = document.querySelector(".navbar");
        if (window.scrollY > 50) {
          navbar.classList.add("scrolled");
        } else {
          navbar.classList.remove("scrolled");
        }
      });

      // Animate numbers
      const animateNumbers = () => {
        const stats = document.querySelectorAll('.stat-number[data-target]');
        stats.forEach(stat => {
          const target = parseInt(stat.getAttribute('data-target'));
          const duration = 2000;
          const increment = target / (duration / 16);
          let current = 0;
          
          const updateNumber = () => {
            current += increment;
            if (current < target) {
              stat.textContent = Math.floor(current);
              requestAnimationFrame(updateNumber);
            } else {
              stat.textContent = target;
            }
          };
          
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                updateNumber();
                observer.unobserve(stat);
              }
            });
          }, { threshold: 0.5 });
          
          observer.observe(stat);
        });
      };

      // Animate elements on scroll
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
          }
        });
      }, observerOptions);

      document.querySelectorAll('.story-item-creative, .interest-item, .timeline-item-compact').forEach(el => {
        observer.observe(el);
      });

      // Horizontal text hover images - follow cursor
      const horizontalWords = document.querySelectorAll('.horizontal-word');
      const cursorImage = document.createElement('div');
      cursorImage.className = 'cursor-hover-image';
      document.body.appendChild(cursorImage);
      
      let currentImageUrl = '';
      let isHovering = false;
      
      horizontalWords.forEach(word => {
        const imageUrl = word.getAttribute('data-image');
        
        word.addEventListener('mouseenter', () => {
          currentImageUrl = imageUrl;
          isHovering = true;
          cursorImage.style.backgroundImage = `url(${imageUrl})`;
          cursorImage.style.opacity = '1';
        });
        
        word.addEventListener('mouseleave', () => {
          isHovering = false;
          currentImageUrl = '';
          cursorImage.style.opacity = '0';
        });
        
        word.addEventListener('mousemove', (e) => {
          if (isHovering && currentImageUrl === imageUrl) {
            cursorImage.style.left = e.clientX + 20 + 'px';
            cursorImage.style.top = e.clientY + 20 + 'px';
          }
        });
      });

      // Terminal Animation
      const terminalCommand = document.getElementById('terminal-command');
      const terminalOutput = document.getElementById('terminal-output');
      const terminalCursor = document.getElementById('terminal-cursor');
      
      const commands = [
        { cmd: "whoami", output: "Arai Nanami Rachel\nDesigner & Developer" },
        { cmd: "cat about.txt", output: "Passionate about creating innovative solutions\nthat bridge design and engineering." },
        { cmd: "ls projects/", output: "MyVinyl/  Project2/  Project3/  Project4/  Project5/" },
        { cmd: "echo $PASSION", output: "Learning, experimenting, and turning ideas\ninto something real and impactful." },
        { cmd: "git status", output: "On branch main\nYour portfolio is up to date!" }
      ];
      
      let currentCommandIndex = 0;
      let isTyping = false;
      
      function typeCommand(command, callback) {
        if (isTyping) return;
        isTyping = true;
        
        let charIndex = 0;
        terminalCommand.textContent = '';
        terminalOutput.textContent = '';
        terminalCursor.style.opacity = '1';
        
        const typeInterval = setInterval(() => {
          if (charIndex < command.length) {
            terminalCommand.textContent += command[charIndex];
            charIndex++;
          } else {
            clearInterval(typeInterval);
            setTimeout(() => {
              terminalCursor.style.opacity = '0';
              if (callback) callback();
            }, 500);
          }
        }, 60);
      }
      
      function showOutput(output, callback) {
        setTimeout(() => {
          terminalOutput.textContent = output;
          terminalOutput.style.opacity = '0';
          terminalOutput.style.transform = 'translateY(10px)';
          
          setTimeout(() => {
            terminalOutput.style.transition = 'all 0.3s ease';
            terminalOutput.style.opacity = '1';
            terminalOutput.style.transform = 'translateY(0)';
            
            setTimeout(() => {
              if (callback) callback();
            }, 2500);
          }, 50);
        }, 300);
      }
      
      function runNextCommand() {
        if (currentCommandIndex < commands.length) {
          const { cmd, output } = commands[currentCommandIndex];
          
          typeCommand(cmd, () => {
            showOutput(output, () => {
              isTyping = false;
              currentCommandIndex = (currentCommandIndex + 1) % commands.length;
              setTimeout(() => {
                runNextCommand();
              }, 1000);
            });
          });
        }
      }
      
      // Start terminal when page loads
      setTimeout(() => {
        runNextCommand();
      }, 1000);
      
      // Click terminal to cycle commands
      const terminal = document.getElementById('terminal');
      if (terminal) {
        terminal.addEventListener('click', () => {
          if (!isTyping) {
            currentCommandIndex = (currentCommandIndex + 1) % commands.length;
            runNextCommand();
          }
        });
        terminal.style.cursor = 'pointer';
      }

      // Enhanced Parallax Gallery Effect - Horizontal Scrolling
      const parallaxTrack = document.getElementById('parallax-track');
      const parallaxImages = document.querySelectorAll('.parallax-image');
      
      // Duplicate images for seamless loop
      if (parallaxTrack && parallaxImages.length > 0) {
        parallaxImages.forEach(img => {
          const clone = img.cloneNode(true);
          parallaxTrack.appendChild(clone);
        });
      }
      
      function updateParallax() {
        if (parallaxTrack) {
          const gallerySection = document.querySelector('.parallax-gallery');
          if (gallerySection) {
            const rect = gallerySection.getBoundingClientRect();
            const windowHeight = window.innerHeight;
            const isVisible = rect.top < windowHeight && rect.bottom > -200;
            
            if (isVisible) {
              // Calculate scroll progress
              const scrollY = window.scrollY;
              const sectionTop = scrollY + rect.top - windowHeight;
              const sectionHeight = rect.height + windowHeight;
              const scrollProgress = Math.max(0, Math.min(1, (scrollY - sectionTop) / sectionHeight));
              
              // Continuous horizontal scrolling
              const imageWidth = 260 + 18; // width + gap
              const totalWidth = imageWidth * parallaxImages.length;
              const maxScroll = totalWidth;
              const currentScroll = scrollProgress * maxScroll;
              
              parallaxTrack.style.transform = `translateX(-${currentScroll}px)`;
              
              // Reset position for seamless loop
              if (currentScroll >= totalWidth) {
                parallaxTrack.style.transform = `translateX(0px)`;
              }
            }
          }
        }
      }
      
      // Smooth parallax on scroll
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            updateParallax();
            ticking = false;
          });
          ticking = true;
        }
      });
      
      updateParallax();

      animateNumbers();

      // GitHub Integration
      const GITHUB_USERNAME = 'borkthecat';
      
      async function fetchGitHubData() {
        try {
          // Fetch user repos
          const reposResponse = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=3`);
          const repos = await reposResponse.json();
          
          // Fetch user data for contribution count
          const userResponse = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}`);
          const userData = await userResponse.json();
          
          // Display repos
          const reposGrid = document.getElementById('github-repos');
          if (reposGrid && repos.length > 0) {
            reposGrid.innerHTML = repos.slice(0, 3).map(repo => {
              const language = repo.language || 'Other';
              const languageClass = language.toLowerCase();
              const isFeatured = repo.stargazers_count > 0 || repo.name.includes('template') || repo.name.includes('portfolio');
              
              return `
                <a href="${repo.html_url}" target="_blank" rel="noopener noreferrer" class="repo-card">
                  <div class="repo-card-header">
                    <svg class="repo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <h4 class="repo-name">
                      ${repo.name}
                      ${isFeatured ? '<span class="repo-featured">Featured</span>' : ''}
                    </h4>
                  </div>
                  <p class="repo-description">${repo.description || 'No description available.'}</p>
                  <div class="repo-tags">
                    ${repo.topics && repo.topics.length > 0 ? repo.topics.slice(0, 3).map(topic => 
                      `<span class="repo-tag">${topic}</span>`
                    ).join('') : ''}
                    ${!repo.topics || repo.topics.length === 0 ? `<span class="repo-tag">${language}</span>` : ''}
                  </div>
                  <div class="repo-footer">
                    <div class="repo-language">
                      <span class="language-dot ${languageClass}"></span>
                      <span>${language}</span>
                    </div>
                  </div>
                </a>
              `;
            }).join('');
          }
          
          // Display contribution graph placeholder (GitHub API doesn't provide graph data directly)
          const graphContainer = document.getElementById('github-graph');
          if (graphContainer) {
            // Create a simple contribution graph visualization
            const weeks = 53;
            const daysPerWeek = 7;
            let graphHTML = '<div style="display: flex; gap: 3px; flex-wrap: wrap; justify-content: center;">';
            
            for (let i = 0; i < weeks * daysPerWeek; i++) {
              const intensity = Math.floor(Math.random() * 4); // 0-3 intensity levels
              const colors = ['#161b22', '#0e4429', '#006d32', '#26a641', '#39d353'];
              graphHTML += `<div style="width: 10px; height: 10px; background: ${colors[intensity]}; border-radius: 2px;"></div>`;
            }
            graphHTML += '</div>';
            graphContainer.innerHTML = graphHTML;
          }
          
          // Display stats
          const statsContainer = document.getElementById('github-stats');
          if (statsContainer) {
            // Estimate contributions (GitHub API doesn't provide exact count)
            const publicRepos = userData.public_repos || 0;
            const estimatedContributions = Math.floor(publicRepos * 12.5); // Rough estimate
            
            statsContainer.innerHTML = `
              <span class="contributions-count">${estimatedContributions.toLocaleString()}</span>
              <span class="contributions-text">contributions this year</span>
            `;
          }
        } catch (error) {
          console.error('Error fetching GitHub data:', error);
          const reposGrid = document.getElementById('github-repos');
          if (reposGrid) {
            reposGrid.innerHTML = '<div class="repo-loading">Unable to load repositories. <a href="https://github.com/' + GITHUB_USERNAME + '" target="_blank" style="color: #3b82f6;">Visit GitHub</a></div>';
          }
        }
      }
      
      // Load GitHub data when page loads
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fetchGitHubData);
      } else {
        fetchGitHubData();
      }

      const searchWrapper = document.querySelector(".search-wrapper");
      const searchToggle = document.querySelector(".search-toggle");
      const searchInput = document.querySelector(".search-input");

      if (searchToggle) {
        searchToggle.addEventListener("click", () => {
          searchWrapper.classList.toggle("active");
          if (searchWrapper.classList.contains("active")) {
            searchInput.focus();
          }
        });
      }

      document.addEventListener("click", (e) => {
        if (searchWrapper && !searchWrapper.contains(e.target)) {
          searchWrapper.classList.remove("active");
        }
      });

      document.addEventListener("DOMContentLoaded", () => {
        const browseMenu = document.querySelector(".browse-menu");
        const browseBtn = document.querySelector(".browse-btn");

        if (browseBtn) {
          browseBtn.addEventListener("click", () => {
            browseMenu.classList.toggle("active");
          });

          document.addEventListener("click", (e) => {
            if (browseMenu && !browseMenu.contains(e.target)) {
              browseMenu.classList.remove("active");
            }
          });
        }
      });
    </script>
  </body>
</html>
