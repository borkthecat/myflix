<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profiles - MyFlix</title>
    <link rel="stylesheet" href="/styles/profiles.css" />
  </head>

  <body>
    <!-- Navbar -->
    <header class="nav">
      <img src="/images/logo.png" alt="MyFlix Logo" class="logo" />
    </header>

    <!-- Main Content -->
    <main class="container">
      <h1 class="title">Who's watching?</h1>
      <div class="profiles">
        <a href="/home?user=user1" class="profile">
          <img src="/images/user1.jpg" alt="User 1" />
          <span>User 1</span>
        </a>
        <a href="/home?user=user2" class="profile">
          <img src="/images/user2.jpg" alt="User 2" />
          <span>User 2</span>
        </a>
        <a href="/home?user=user3" class="profile">
          <img src="/images/user3.jpg" alt="User 3" />
          <span>User 3</span>
        </a>
        <a href="/home?user=user4" class="profile">
          <img src="/images/user4.jpg" alt="User 4" />
          <span>User 4</span>
        </a>
      </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-container">
        <!-- Socials aligned left -->
        <div class="socials">
          <a href="mailto:contact@example.com">
            <img src="/icons/mail.svg" alt="Email" />
          </a>
          <a href="https://www.linkedin.com/in/arai-nanami-rachel" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="#">
            <img src="/icons/instagram.svg" alt="Instagram" />
          </a>
          <a href="#">
            <img src="/icons/contact.svg" alt="Contact" />
          </a>
        </div>

        <!-- Links grid in the middle -->
        <div class="links">
          <a href="/about">About</a>
          <a href="/home#projects">Projects</a>
          <a href="/home#skills">Skills</a>
          <a href="/home#languages">Languages</a>
          <a href="/home#experience">Experience</a>
          <a href="mailto:contact@example.com">Contact Me</a>
          <a href="#">Privacy</a>
          <a href="#">Terms</a>
        </div>

        <!-- Copyright left -->
        <div class="copyright">
          © <span id="year"></span> Arai Nanami Rachel. All rights reserved.
        </div>
      </div>
    </footer>

    <script>
      // Auto year update
      document.getElementById("year").textContent = new Date().getFullYear();

      // Save profile choice in localStorage
      document.querySelectorAll(".profile").forEach((link) => {
        link.addEventListener("click", () => {
          const user = new URL(link.href).searchParams.get("user");
          localStorage.setItem("selectedUser", user);
        });
      });
    </script>
  </body>
</html>
