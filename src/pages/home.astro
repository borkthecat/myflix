            rotationSpeed: 0.04,
            hasAtmosphere: true,
            atmosphereColor: 0xe8dab9,
            hasMoons: true,
            moonCount: 4
          },
          { 
            name: 'Saturn', 
            color: 0xfad5a5, 
            darkColor: 0xdab585,
            size: 0.6, 
            distance: 12.5, 
            speed: 0.0015,
            rotationSpeed: 0.03,
            hasAtmosphere: true,
            atmosphereColor: 0xffe4b5,
            hasRings: true,
            hasMoons: true,
            moonCount: 2
          },
          { 
            name: 'Uranus', 
            color: 0x4fd0e7, 
            darkColor: 0x2fa0b7,
            size: 0.35, 
            distance: 15, 
            speed: 0.001,
            rotationSpeed: -0.02,
            hasAtmosphere: true,
            atmosphereColor: 0x6fe0f7
          },
          { 
            name: 'Neptune', 
            color: 0x4166f5, 
            darkColor: 0x2146d5,
            size: 0.35, 
            distance: 17.5, 
            speed: 0.0008,
            rotationSpeed: 0.025,
            hasAtmosphere: true,
            atmosphereColor: 0x6186ff
          }
        ];
        
        // Create detailed planets
        planetData.forEach((data, index) => {
          // Higher detail geometry
          const planetGeometry = new THREE.SphereGeometry(data.size, 64, 64);
          
          // Create planet material with vibrant colors
          const planetMaterial = new THREE.MeshPhongMaterial({
            color: data.color,
            shininess: 30,
            specular: new THREE.Color(0x333333),
            emissive: new THREE.Color(data.color).multiplyScalar(0.15)
          });
          
          const planet = new THREE.Mesh(planetGeometry, planetMaterial);
          
          // Position planets in a circle around the sun
          const angle = (index / planetData.length) * Math.PI * 2;
          planet.position.x = Math.cos(angle) * data.distance;
          planet.position.z = Math.sin(angle) * data.distance;
          planet.position.y = (Math.random() - 0.5) * 1.5;
          
          // Add atmosphere if applicable
          if (data.hasAtmosphere) {
            const atmosphereGeometry = new THREE.SphereGeometry(data.size * 1.1, 32, 32);
            const atmosphereMaterial = new THREE.MeshPhongMaterial({
              color: data.atmosphereColor,
              transparent: true,
              opacity: 0.3,
              side: THREE.BackSide
            });
            const atmosphere = new THREE.Mesh(atmosphereGeometry, atmosphereMaterial);
            planet.add(atmosphere);
          }
          
          // Add rings for Saturn
          if (data.hasRings) {
            const ringGeometry = new THREE.RingGeometry(data.size * 1.2, data.size * 2, 64);
            const ringMaterial = new THREE.MeshBasicMaterial({
              color: 0xc0c0c0,
              side: THREE.DoubleSide,
              transparent: true,
              opacity: 0.7
            });
            const rings = new THREE.Mesh(ringGeometry, ringMaterial);
            rings.rotation.x = Math.PI / 2;
            planet.add(rings);
          }
          
          // Store rotation data
          planet.userData = {
            angle: angle,
            distance: data.distance,
            speed: data.speed,
            rotationSpeed: data.rotationSpeed,
            initialY: planet.position.y
          };
          
          scene.add(planet);
          planets.push(planet);
          
          // Add moons
          if (data.hasMoon) {
            const moonGeometry = new THREE.SphereGeometry(data.size * 0.15, 16, 16);
            const moonMaterial = new THREE.MeshPhongMaterial({
              color: 0x888888,
              shininess: 5
            });
            const moon = new THREE.Mesh(moonGeometry, moonMaterial);
            moon.userData = {
              parentPlanet: planet,
              distance: data.size * 1.5,
              angle: Math.random() * Math.PI * 2,
              speed: data.speed * 3
            };
            scene.add(moon);
            moons.push(moon);
          } else if (data.hasMoons) {
            for (let i = 0; i < data.moonCount; i++) {
              const moonGeometry = new THREE.SphereGeometry(data.size * 0.1, 16, 16);
              const moonMaterial = new THREE.MeshPhongMaterial({
                color: 0x888888,
                shininess: 5
              });
              const moon = new THREE.Mesh(moonGeometry, moonMaterial);
              moon.userData = {
                parentPlanet: planet,
                distance: data.size * (1.5 + i * 0.3),
                angle: (i / data.moonCount) * Math.PI * 2,
                speed: data.speed * (2 + i * 0.5)
              };
              scene.add(moon);
              moons.push(moon);
            }
          }
          
          console.log(`${data.name} created with details`);
        });
        
        // Create asteroid belt between Mars and Jupiter
        const asteroidBeltRadius = 8.5;
        const asteroidBeltWidth = 1.5;
        for (let i = 0; i < 200; i++) {
          const asteroidSize = Math.random() * 0.05 + 0.02;
          const asteroidGeometry = new THREE.DodecahedronGeometry(asteroidSize, 0);
          const asteroidMaterial = new THREE.MeshPhongMaterial({
            color: 0x666666,
            shininess: 5
          });
          const asteroid = new THREE.Mesh(asteroidGeometry, asteroidMaterial);
          
          const angle = Math.random() * Math.PI * 2;
          const distance = asteroidBeltRadius + (Math.random() - 0.5) * asteroidBeltWidth;
          asteroid.position.x = Math.cos(angle) * distance;
          asteroid.position.z = Math.sin(angle) * distance;
          asteroid.position.y = (Math.random() - 0.5) * 2;
          
          asteroid.userData = {
            angle: angle,
            distance: distance,
            speed: 0.003,
            rotationSpeed: {
              x: (Math.random() - 0.5) * 0.02,
              y: (Math.random() - 0.5) * 0.02,
              z: (Math.random() - 0.5) * 0.02
            }
          };
          
          scene.add(asteroid);
          asteroids.push(asteroid);
        }
        console.log('Asteroid belt created with 200 asteroids');
        
        // Create comets with bright, recognizable tails that orbit properly
        for (let i = 0; i < 3; i++) {
          const cometSize = 0.12;
          const cometGeometry = new THREE.SphereGeometry(cometSize, 16, 16);
          const cometMaterial = new THREE.MeshBasicMaterial({
            color: 0xffffff,
            emissive: 0xaaccff,
            emissiveIntensity: 3
          });
          const comet = new THREE.Mesh(cometGeometry, cometMaterial);
          
          const distance = 18 + Math.random() * 8;
          const angle = Math.random() * Math.PI * 2;
          comet.position.x = Math.cos(angle) * distance;
          comet.position.z = Math.sin(angle) * distance;
          comet.position.y = (Math.random() - 0.5) * 4;
          
          // Create bright, visible comet tail with multiple layers
          // Tail should point away from the sun (opposite to orbital direction)
          const tailLength = 1.2;
          const tailWidth = 0.15;
          
          // Create a group for the tail so we can orient it properly
          const tailGroup = new THREE.Group();
          
          // Outer glow tail
          const outerTailGeometry = new THREE.ConeGeometry(tailWidth, tailLength, 16);
          const outerTailMaterial = new THREE.MeshBasicMaterial({
            color: 0x88ccff,
            transparent: true,
            opacity: 0.4,
            side: THREE.DoubleSide
          });
          const outerTail = new THREE.Mesh(outerTailGeometry, outerTailMaterial);
          outerTail.rotation.x = Math.PI / 2;
          outerTail.position.z = -tailLength / 2;
          tailGroup.add(outerTail);
          
          // Inner bright tail
          const innerTailGeometry = new THREE.ConeGeometry(tailWidth * 0.6, tailLength, 12);
          const innerTailMaterial = new THREE.MeshBasicMaterial({
            color: 0xffffff,
            emissive: 0xffffff,
            emissiveIntensity: 2,
            transparent: true,
            opacity: 0.8,
            side: THREE.DoubleSide
          });
          const innerTail = new THREE.Mesh(innerTailGeometry, innerTailMaterial);
          innerTail.rotation.x = Math.PI / 2;
          innerTail.position.z = -tailLength / 2;
          tailGroup.add(innerTail);
          
          // Orient tail group to point away from sun (radial direction)
          tailGroup.lookAt(0, comet.position.y, 0);
          tailGroup.rotateY(Math.PI);
          comet.add(tailGroup);
          
          comet.userData = {
            angle: angle,
            distance: distance,
            speed: 0.0015 + Math.random() * 0.001,
            rotationSpeed: 0.03,
            tailGroup: tailGroup
          };
          
          scene.add(comet);
          comets.push(comet);
        }
        console.log('Comets created with bright tails');
        
        // Create shooting stars with visible trails
        for (let i = 0; i < 2; i++) {
          const trailLength = 0.8;
          const trailGeometry = new THREE.BufferGeometry();
          const trailMaterial = new THREE.LineBasicMaterial({
            color: 0xffffff,
            transparent: true,
            opacity: 0.9
          });
          
          // Create trail vertices
          const trailVertices = [];
          for (let j = 0; j < 20; j++) {
            const t = j / 19;
            trailVertices.push(0, 0, -t * trailLength);
          }
          trailGeometry.setAttribute('position', new THREE.Float32BufferAttribute(trailVertices, 3));
          
          const shootingStar = new THREE.Line(trailGeometry, trailMaterial);
          
          // Add bright head
          const headGeometry = new THREE.SphereGeometry(0.08, 8, 8);
          const headMaterial = new THREE.MeshBasicMaterial({
            color: 0xffffff,
            emissive: 0xffffff,
            emissiveIntensity: 5
          });
          const head = new THREE.Mesh(headGeometry, headMaterial);
          shootingStar.add(head);
          
          const startX = (Math.random() - 0.5) * 40;
          const startY = (Math.random() - 0.5) * 40;
          const startZ = (Math.random() - 0.5) * 40;
          shootingStar.position.set(startX, startY, startZ);
          
          const direction = new THREE.Vector3(
            (Math.random() - 0.5) * 2,
            (Math.random() - 0.5) * 2,
            (Math.random() - 0.5) * 2
          ).normalize();
          
          // Orient the shooting star along its direction
          shootingStar.lookAt(
            shootingStar.position.x + direction.x,
            shootingStar.position.y + direction.y,
            shootingStar.position.z + direction.z
          );
          shootingStar.rotateX(Math.PI / 2);
          
          shootingStar.userData = {
            direction: direction,
            speed: 0.4 + Math.random() * 0.3,
            life: 0,
            maxLife: 150 + Math.random() * 100
          };
          
          scene.add(shootingStar);
          shootingStars.push(shootingStar);
        }
        console.log('Shooting stars created with visible trails');
        
        // Store for compatibility
        let earth = planets[2];
        let continents = planets;
        
        // Add extensive stars background that covers ENTIRE hero section (behind text too)
        const starsGeometry = new THREE.BufferGeometry();
        const starsMaterial = new THREE.PointsMaterial({
          color: 0xffffff,
          size: 1.5,
          transparent: true,
          opacity: 0.9
        });
        const starsVertices = [];
        // Create stars in a much larger area to cover entire hero section including behind text
        // Position stars to cover the full width and height of hero section
        const heroSection = document.querySelector('.hero');
        const heroWidth = heroSection ? heroSection.offsetWidth : window.innerWidth;
        const heroHeight = heroSection ? heroSection.offsetHeight : window.innerHeight;
        
        for (let i = 0; i < 30000; i++) {
          // Spread stars across entire hero section width and height
          const x = (Math.random() - 0.5) * heroWidth * 2;
          const y = (Math.random() - 0.5) * heroHeight * 2;
          const z = (Math.random() - 0.5) * 5000; // Deep space
          starsVertices.push(x, y, z);
        }
        starsGeometry.setAttribute('position', new THREE.Float32BufferAttribute(starsVertices, 3));
        const stars = new THREE.Points(starsGeometry, starsMaterial);
        scene.add(stars);
        console.log('Extended stars background added across entire hero');
        
        // Add vibrant, warm lighting (like sunlight)
        const ambientLight = new THREE.AmbientLight(0xffffff, 1.5);
        scene.add(ambientLight);
        console.log('Ambient light added');
        
        // Main sunlight (warm yellow)
        const directionalLight = new THREE.DirectionalLight(0xfff8dc, 2);
        directionalLight.position.set(5, 5, 5);
        scene.add(directionalLight);
        console.log('Sunlight added');
        
        // Secondary warm light
        const pointLight = new THREE.PointLight(0xffebcd, 1.2);
        pointLight.position.set(-5, 0, 5);
        scene.add(pointLight);
        
        // Rim light for depth
        const rimLight = new THREE.DirectionalLight(0x87ceeb, 0.8);
        rimLight.position.set(-5, -3, -5);
        scene.add(rimLight);
        console.log('Vibrant lighting added');
        
        // Position camera to view entire solar system - free camera system
        let cameraDistance = 25;
        let cameraTheta = 0; // Horizontal rotation (around Y axis)
        let cameraPhi = Math.PI / 3; // Vertical rotation (elevation)
        
        function updateCameraPosition() {
          camera.position.x = cameraDistance * Math.sin(cameraPhi) * Math.cos(cameraTheta);
          camera.position.y = cameraDistance * Math.cos(cameraPhi);
          camera.position.z = cameraDistance * Math.sin(cameraPhi) * Math.sin(cameraTheta);
          camera.lookAt(0, 0, 0);
        }
        
        updateCameraPosition();
        
        camera.userData = { 
          distance: cameraDistance,
          minDistance: 3,
          maxDistance: 60,
          theta: cameraTheta,
          phi: cameraPhi
        };
        console.log('Free camera positioned');
        
        // Free camera controls with auto-orbit
        let isDragging = false;
        let previousMousePosition = { x: 0, y: 0 };
        let rotationSpeed = { x: 0, y: 0 };
        let autoOrbitSpeed = 0.002; // Auto-orbit speed when not dragging
        let userHasInteracted = false; // Track if user has manually moved camera
        
        canvas.addEventListener('mousedown', (e) => {
          isDragging = true;
          previousMousePosition = { x: e.clientX, y: e.clientY };
          canvas.style.cursor = 'grabbing';
        });
        
        canvas.addEventListener('mousemove', (e) => {
          if (isDragging) {
            userHasInteracted = true;
            const deltaX = e.clientX - previousMousePosition.x;
            const deltaY = e.clientY - previousMousePosition.y;
            
            // Free rotation - horizontal and vertical
            rotationSpeed.y = -deltaX * 0.005;
            rotationSpeed.x = deltaY * 0.005;
            
            // Update spherical coordinates
            cameraTheta += rotationSpeed.y;
            cameraPhi += rotationSpeed.x;
            
            // Limit vertical rotation to prevent flipping
            cameraPhi = Math.max(0.1, Math.min(Math.PI - 0.1, cameraPhi));
            
            // Update camera position
            updateCameraPosition();
            
            previousMousePosition = { x: e.clientX, y: e.clientY };
          }
        });
        
        canvas.addEventListener('mouseup', () => {
          isDragging = false;
          canvas.style.cursor = 'grab';
        });
        
        canvas.addEventListener('mouseleave', () => {
          isDragging = false;
          canvas.style.cursor = 'grab';
        });
        
        // Make planets clickable with unique particle explosion effect
        let clickStartTime = 0;
        let clickStartPos = { x: 0, y: 0 };
        let clickedPlanetParticles = [];
        
        canvas.addEventListener('mousedown', (e) => {
          clickStartTime = Date.now();
          clickStartPos = { x: e.clientX, y: e.clientY };
        });
        
        canvas.addEventListener('click', (e) => {
          // Only trigger planet click if it was a quick click (not a drag)
          const clickDuration = Date.now() - clickStartTime;
          const clickDistance = Math.sqrt(
            Math.pow(e.clientX - clickStartPos.x, 2) + 
            Math.pow(e.clientY - clickStartPos.y, 2)
          );
          
          if (clickDuration < 200 && clickDistance < 5) {
            const rect = canvas.getBoundingClientRect();
            mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
            mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
            
            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(planets);
            
            if (intersects.length > 0) {
              const clickedPlanet = intersects[0].object;
              
              // Create particle explosion effect
              const particleCount = 30;
              let planetColor = 0xffffff;
              if (clickedPlanet.material && clickedPlanet.material.color) {
                if (typeof clickedPlanet.material.color.getHex === 'function') {
                  planetColor = clickedPlanet.material.color.getHex();
                } else if (typeof clickedPlanet.material.color === 'number') {
                  planetColor = clickedPlanet.material.color;
                }
              }
              
              // Clear previous particles
              clickedPlanetParticles.forEach(particle => scene.remove(particle));
              clickedPlanetParticles = [];
              
              // Create particles
              for (let i = 0; i < particleCount; i++) {
                const particleGeometry = new THREE.SphereGeometry(0.05, 8, 8);
                const particleMaterial = new THREE.MeshBasicMaterial({
                  color: planetColor,
                  emissive: planetColor,
                  emissiveIntensity: 2
                });
                const particle = new THREE.Mesh(particleGeometry, particleMaterial);
                
                particle.position.copy(clickedPlanet.position);
                
                const angle = (i / particleCount) * Math.PI * 2;
                const speed = 0.1 + Math.random() * 0.1;
                particle.userData = {
                  velocity: new THREE.Vector3(
                    Math.cos(angle) * speed,
                    (Math.random() - 0.5) * speed * 0.5,
                    Math.sin(angle) * speed
                  ),
                  life: 0,
                  maxLife: 60
                };
                
                scene.add(particle);
                clickedPlanetParticles.push(particle);
              }
              
              // Temporarily scale up the planet
              clickedPlanet.userData.originalScale = clickedPlanet.scale.x;
              clickedPlanet.userData.pulseScale = 1.3;
            }
          }
        });
        
        // Zoom functionality - move camera forward/backward
        canvas.addEventListener('wheel', (e) => {
          e.preventDefault();
          userHasInteracted = true;
          const zoomSpeed = 0.5;
          const delta = e.deltaY > 0 ? zoomSpeed : -zoomSpeed;
          
          cameraDistance = Math.max(
            camera.userData.minDistance,
            Math.min(camera.userData.maxDistance, cameraDistance + delta)
          );
          
          camera.userData.distance = cameraDistance;
          updateCameraPosition();
        });
        
        // Touch support
        let touchStart = { x: 0, y: 0 };
        
        canvas.addEventListener('touchstart', (e) => {
          e.preventDefault();
          isDragging = true;
          touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
        });
        
        canvas.addEventListener('touchmove', (e) => {
          e.preventDefault();
          if (isDragging) {
            userHasInteracted = true;
            const deltaX = e.touches[0].clientX - touchStart.x;
            const deltaY = e.touches[0].clientY - touchStart.y;
            
            // Free rotation for touch
            rotationSpeed.y = -deltaX * 0.005;
            rotationSpeed.x = deltaY * 0.005;
            
            // Update spherical coordinates
            cameraTheta += rotationSpeed.y;
            cameraPhi += rotationSpeed.x;
            
            // Limit vertical rotation
            cameraPhi = Math.max(0.1, Math.min(Math.PI - 0.1, cameraPhi));
            
            // Update camera position
            updateCameraPosition();
            
            touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
          }
        });
        
        canvas.addEventListener('touchend', () => {
          isDragging = false;
        });
        
        // Momentum/inertia for smooth rotation and auto-orbit
        function applyMomentum() {
          if (!isDragging) {
            // Apply momentum from user interaction
            rotationSpeed.y *= 0.95;
            rotationSpeed.x *= 0.95;
            
            // Apply momentum to camera rotation
            if (Math.abs(rotationSpeed.y) > 0.001 || Math.abs(rotationSpeed.x) > 0.001) {
              cameraTheta += rotationSpeed.y;
              cameraPhi += rotationSpeed.x;
              
              // Limit vertical rotation
              cameraPhi = Math.max(0.1, Math.min(Math.PI - 0.1, cameraPhi));
              
              updateCameraPosition();
            } else {
              rotationSpeed = { x: 0, y: 0 };
              
              // Auto-orbit when momentum has stopped (always, even after user interaction)
              cameraTheta += autoOrbitSpeed;
              updateCameraPosition();
            }
          }
        }
        
        // Animation loop
        function animate() {
          requestAnimationFrame(animate);
          
          // Apply momentum
          applyMomentum();
          
          // Always rotate planets around the sun
          planets.forEach(planet => {
            if (planet && planet.userData) {
              planet.userData.angle += planet.userData.speed;
              planet.position.x = Math.cos(planet.userData.angle) * planet.userData.distance;
              planet.position.z = Math.sin(planet.userData.angle) * planet.userData.distance;
              // Rotate planet on its own axis
              if (planet.rotation) {
                planet.rotation.y += planet.userData.rotationSpeed;
              }
            }
          });
          
          // Rotate moons around their planets
          moons.forEach(moon => {
            if (moon && moon.userData && moon.userData.parentPlanet) {
              const parent = moon.userData.parentPlanet;
              moon.userData.angle += moon.userData.speed;
              moon.position.x = parent.position.x + Math.cos(moon.userData.angle) * moon.userData.distance;
              moon.position.z = parent.position.z + Math.sin(moon.userData.angle) * moon.userData.distance;
              moon.position.y = parent.position.y;
              // Rotate moon on its own axis
              if (moon.rotation) {
                moon.rotation.y += 0.02;
              }
            }
          });
          
          // Rotate asteroids in the belt
          asteroids.forEach(asteroid => {
            if (asteroid && asteroid.userData) {
              asteroid.userData.angle += asteroid.userData.speed;
              asteroid.position.x = Math.cos(asteroid.userData.angle) * asteroid.userData.distance;
              asteroid.position.z = Math.sin(asteroid.userData.angle) * asteroid.userData.distance;
              // Rotate asteroid randomly
              if (asteroid.rotation) {
                asteroid.rotation.x += asteroid.userData.rotationSpeed.x;
                asteroid.rotation.y += asteroid.userData.rotationSpeed.y;
                asteroid.rotation.z += asteroid.userData.rotationSpeed.z;
              }
            }
          });
          
          // Rotate sun
          if (sun && sun.rotation) {
            sun.rotation.y += 0.005;
          }
          
          // Rotate sun glow
          if (sun && sun.children[0] && sun.children[0].rotation) {
            sun.children[0].rotation.y -= 0.003;
          }
          
          // Update comets - make them orbit and orient tail properly
          comets.forEach(comet => {
            if (comet && comet.userData) {
              comet.userData.angle += comet.userData.speed;
              const oldX = comet.position.x;
              const oldZ = comet.position.z;
              comet.position.x = Math.cos(comet.userData.angle) * comet.userData.distance;
              comet.position.z = Math.sin(comet.userData.angle) * comet.userData.distance;
              
              // Orient tail to point away from sun (opposite to velocity direction)
              if (comet.userData.tailGroup) {
                const velocityX = comet.position.x - oldX;
                const velocityZ = comet.position.z - oldZ;
                if (Math.abs(velocityX) > 0.001 || Math.abs(velocityZ) > 0.001) {
                  comet.userData.tailGroup.lookAt(
                    comet.position.x - velocityX * 10,
                    comet.position.y,
                    comet.position.z - velocityZ * 10
                  );
                  comet.userData.tailGroup.rotateY(Math.PI);
                }
              }
              
              // Rotate comet
              if (comet.rotation) {
                comet.rotation.y += comet.userData.rotationSpeed;
              }
            }
          });
          
          // Update shooting stars
          shootingStars.forEach((star, index) => {
            if (star && star.userData) {
              star.userData.life++;
              if (star.userData.life > star.userData.maxLife) {
                // Reset shooting star
                star.userData.life = 0;
                const startX = (Math.random() - 0.5) * 40;
                const startY = (Math.random() - 0.5) * 40;
                const startZ = (Math.random() - 0.5) * 40;
                star.position.set(startX, startY, startZ);
                star.userData.direction = new THREE.Vector3(
                  (Math.random() - 0.5) * 2,
                  (Math.random() - 0.5) * 2,
                  (Math.random() - 0.5) * 2
                ).normalize();
                
                // Re-orient the shooting star
                star.lookAt(
                  star.position.x + star.userData.direction.x,
                  star.position.y + star.userData.direction.y,
                  star.position.z + star.userData.direction.z
                );
                star.rotateX(Math.PI / 2);
              } else {
                // Move shooting star
                star.position.add(
                  star.userData.direction.clone().multiplyScalar(star.userData.speed)
                );
                // Fade out as it travels
                const opacity = 1 - (star.userData.life / star.userData.maxLife);
                if (star.material) star.material.opacity = opacity * 0.9;
                if (star.children[0] && star.children[0].material) {
                  star.children[0].material.opacity = opacity;
                }
              }
            }
          });
          
          // Update particle explosion effect
          clickedPlanetParticles.forEach((particle, index) => {
            if (particle && particle.userData) {
              particle.userData.life++;
              
              if (particle.userData.life < particle.userData.maxLife) {
                // Move particle
                particle.position.add(particle.userData.velocity);
                particle.userData.velocity.multiplyScalar(0.98); // Friction
                
                // Fade out
                const opacity = 1 - (particle.userData.life / particle.userData.maxLife);
                particle.material.opacity = opacity;
                particle.scale.setScalar(opacity);
              } else {
                // Remove particle
                scene.remove(particle);
                clickedPlanetParticles.splice(index, 1);
              }
            }
          });
          
          // Pulse effect for clicked planet
          planets.forEach(planet => {
            if (planet.userData && planet.userData.pulseScale) {
              const originalScale = planet.userData.originalScale || 1;
              const pulseSpeed = 0.1;
              const scaleDiff = planet.userData.pulseScale - originalScale;
              
              if (Math.abs(scaleDiff) > 0.01) {
                planet.userData.pulseScale -= scaleDiff * pulseSpeed;
                planet.scale.setScalar(planet.userData.pulseScale);
              } else {
                planet.scale.setScalar(originalScale);
                delete planet.userData.pulseScale;
              }
            }
          });
          
          // Parallax effect - globe scrolls down with page
          const heroSection = document.querySelector('.hero');
          if (heroSection) {
            const rect = heroSection.getBoundingClientRect();
            const scrollY = window.scrollY;
            const heroHeight = heroSection.offsetHeight;
            
            // Move globe down as user scrolls (parallax scroll)
            const scrollOffset = scrollY * 0.5; // Adjust speed of parallax
            const wrapper = canvas.parentElement;
            if (wrapper) {
              wrapper.style.transform = `translateY(${scrollOffset}px)`;
            }
            
            // Parallax effect - fade out globe as user scrolls
            const scrollProgress = Math.max(0, Math.min(1, scrollY / (heroHeight * 2)));
            const opacity = 1 - scrollProgress;
            renderer.domElement.style.opacity = opacity;
          }
          
          renderer.render(scene, camera);
        }
        
        // Handle window resize
        window.addEventListener('resize', () => {
          const { width, height } = getSize();
          renderer.setSize(width, height);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        });
        
        // Test: Render a simple colored rectangle first to verify canvas works
        const testGeometry = new THREE.BoxGeometry(2, 2, 2);
        const testMaterial = new THREE.MeshBasicMaterial({ color: 0xff0000 });
        const testCube = new THREE.Mesh(testGeometry, testMaterial);
        scene.add(testCube);
        renderer.render(scene, camera);
        console.log('Test cube rendered - you should see a red cube if canvas works');
        
        // Remove test cube and render globe
        scene.remove(testCube);
        
        // Force initial render multiple times to ensure visibility
        console.log('Starting render loop...');
        console.log('Canvas element:', canvas);
        console.log('Canvas computed style:', window.getComputedStyle(canvas));
        console.log('Canvas bounding rect:', canvas.getBoundingClientRect());
        
        renderer.render(scene, camera);
        renderer.render(scene, camera);
        renderer.render(scene, camera);
        
        // Verify scene has objects
        console.log('Scene children count:', scene.children.length);
        console.log('Camera position:', camera.position);
        const size = new THREE.Vector2();
        renderer.getSize(size);
        console.log('Renderer size:', size.width, size.height);
        if (earth && earth.position) {
          console.log('Earth position:', earth.position);
          console.log('Earth visible:', earth.visible);
        } else {
          console.log('Earth not loaded yet');
        }
        
        // Check if canvas is actually visible
        const rect = canvas.getBoundingClientRect();
        console.log('Canvas bounding rect:', rect);
        if (rect.width === 0 || rect.height === 0) {
          console.error('Canvas has zero dimensions!');
        }
        
        // Start animation
        animate();
        console.log('Animation started');
        
        // Hide hint after interaction
        const hint = document.querySelector('.globe-hint');
        let hasInteracted = false;
        const hideHint = () => {
          if (!hasInteracted && hint) {
            hasInteracted = true;
            hint.style.transition = 'opacity 0.3s ease';
            hint.style.opacity = '0';
            setTimeout(() => hint.style.display = 'none', 300);
          }
        };
        
        canvas.addEventListener('mousedown', hideHint);
        canvas.addEventListener('touchstart', hideHint);
      }
      
      // Initialize when DOM and Three.js are ready
      function waitForThree() {
        if (typeof THREE !== 'undefined') {
          setTimeout(initGlobe, 100);
        } else {
          setTimeout(waitForThree, 100);
        }
      }
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', waitForThree);
      } else {
        waitForThree();
      }
    </script>

