          type: "Project",
          stack: "React, Tailwind",
          status: "Live",
          owner: "Your Name",
        },
        p4: {
          title: "Project 4",
          tech: "Python • PyTorch",
          desc: "Example description for Project 4.",
          type: "Project",
          stack: "Python, PyTorch",
          status: "In Progress",
          owner: "Your Name",
        },
        p5: {
          title: "Project 5",
          tech: "Data Science • LLM",
          desc: "Example description for Project 5.",
          type: "Project",
          stack: "Python, Pandas, LLM",
          status: "In Progress",
          owner: "Your Name",
        },
      };

      const modal = document.getElementById("modal");
      const modalTitle = document.getElementById("modal-title");
      const modalTech = document.getElementById("modal-tech");
      const modalDesc = document.getElementById("modal-desc");
      const modalType = document.getElementById("modal-type");
      const modalStack = document.getElementById("modal-stack");
      const modalStatus = document.getElementById("modal-status");
      const modalOwner = document.getElementById("modal-owner");
      const modalHeroImage = document.getElementById("modal-hero-image");
      const visitProjectBtn = document.getElementById("visit-project-btn");
      const closeBtn = document.querySelector(".close");

      document.querySelectorAll(".project-card").forEach((card) => {
        card.addEventListener("click", () => {
          const p = projects[card.dataset.project];
          modalTitle.textContent = p.title;
          modalTech.textContent = p.tech;
          modalDesc.textContent = p.desc;
          modalType.textContent = p.type;
          modalStack.textContent = p.stack;
          modalStatus.textContent = p.status;
          if (p.status === "Live") {
            modalStatus.classList.add("status-live");
          } else {
            modalStatus.classList.remove("status-live");
          }
          modalOwner.textContent = p.owner;
          
          // Set visit project button URL
          if (visitProjectBtn && p.url) {
            visitProjectBtn.href = p.url;
          } else if (visitProjectBtn) {
            visitProjectBtn.href = "#";
          }
          
          // Set hero image background
          if (modalHeroImage && p.image) {
            modalHeroImage.style.backgroundImage = `url(${p.image})`;
            modalHeroImage.style.backgroundSize = "cover";
            modalHeroImage.style.backgroundPosition = "center";
          } else if (modalHeroImage) {
            modalHeroImage.style.background = 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
