    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
      // Auto year update
      document.getElementById("year").textContent = new Date().getFullYear();

      // Interactive 3D Globe with Three.js
      function initGlobe() {
        const canvas = document.getElementById('globe-canvas');
        if (!canvas) {
          console.error('Canvas not found');
          return;
        }
        
        if (typeof THREE === 'undefined') {
          console.error('Three.js not loaded');
          setTimeout(initGlobe, 100);
          return;
        }
        
        const scene = new THREE.Scene();
        
        // Get canvas dimensions
        const getSize = () => {
          const rect = canvas.getBoundingClientRect();
          return {
            width: rect.width || 800,
            height: rect.height || 600
          };
        };
        
        let { width, height } = getSize();
        console.log('Initial canvas size:', width, height);
        
        // Ensure minimum dimensions - use parent container size
        const wrapper = canvas.parentElement;
        if (width === 0 || height === 0) {
          const rect = wrapper ? wrapper.getBoundingClientRect() : { width: 800, height: 600 };
          width = rect.width || 800;
          height = rect.height || 600;
          console.log('Using wrapper size:', width, height);
        }
        
        // Set canvas dimensions explicitly
        canvas.width = width;
        canvas.height = height;
        canvas.style.width = width + 'px';
        canvas.style.height = height + 'px';
        
        const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ 
          canvas: canvas, 
          alpha: true, 
          antialias: true
        });
        
        renderer.setSize(width, height, false);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setClearColor(0x000000, 0);
        
        // Initialize raycaster and mouse for planet clicking
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();
        
        // Make canvas visible and ensure it's on top
        canvas.style.display = 'block';
        canvas.style.visibility = 'visible';
        canvas.style.opacity = '1';
        canvas.style.position = 'relative';
        canvas.style.zIndex = '10';
        console.log('Canvas dimensions set:', canvas.width, canvas.height);
        
        // Create detailed solar system with planets, moons, asteroids, and rings
        console.log('Creating detailed solar system...');
        
        let planets = [];
        let moons = [];
        let asteroids = [];
        let comets = [];
        let shootingStars = [];
        let sun;
        
        // Helper function to create gradient material
        function createGradientMaterial(color1, color2) {
          const canvas = document.createElement('canvas');
          canvas.width = 256;
          canvas.height = 256;
          const ctx = canvas.getContext('2d');
          const gradient = ctx.createRadialGradient(128, 128, 0, 128, 128, 128);
          gradient.addColorStop(0, `#${color1.toString(16).padStart(6, '0')}`);
          gradient.addColorStop(1, `#${color2.toString(16).padStart(6, '0')}`);
          ctx.fillStyle = gradient;
          ctx.fillRect(0, 0, 256, 256);
          const texture = new THREE.CanvasTexture(canvas);
          return new THREE.MeshPhongMaterial({ map: texture, shininess: 10 });
        }
        
        // Create the Sun with bright corona effect
        const sunGeometry = new THREE.SphereGeometry(2, 64, 64);
        const sunMaterial = new THREE.MeshBasicMaterial({
          color: 0xffff00,
          emissive: 0xffaa00,
          emissiveIntensity: 5
        });
        sun = new THREE.Mesh(sunGeometry, sunMaterial);
        sun.position.set(0, 0, 0);
        scene.add(sun);
        
        // Add multiple sun glow layers for brightness
        for (let i = 0; i < 3; i++) {
          const glowSize = 2.3 + i * 0.3;
          const sunGlowGeometry = new THREE.SphereGeometry(glowSize, 32, 32);
          const sunGlowMaterial = new THREE.MeshBasicMaterial({
            color: 0xffaa00,
            transparent: true,
            opacity: 0.4 - i * 0.1
          });
          const sunGlow = new THREE.Mesh(sunGlowGeometry, sunGlowMaterial);
          sun.add(sunGlow);
        }
        
        // Add bright point light from sun
        const sunLight = new THREE.PointLight(0xffffff, 3, 100);
        sunLight.position.set(0, 0, 0);
        scene.add(sunLight);
        
        console.log('Bright sun with multiple glow layers created');
        
        // Enhanced planet data with more detail
        const planetData = [
          { 
            name: 'Mercury', 
            color: 0x6b7a8f, 
            darkColor: 0x4a5566,
            size: 0.2, 
            distance: 3.5, 
            speed: 0.008,
            rotationSpeed: 0.02,
            hasAtmosphere: false
          },
          { 
            name: 'Venus', 
            color: 0xff6b35, 
            darkColor: 0xff4500,
            size: 0.25, 
            distance: 4.5, 
            speed: 0.006,
            rotationSpeed: -0.015,
            hasAtmosphere: true,
            atmosphereColor: 0xff8c42
          },
          { 
            name: 'Earth', 
            color: 0x4a90e2, 
            darkColor: 0x2d5aa0,
            size: 0.3, 
            distance: 6, 
            speed: 0.005,
            rotationSpeed: 0.025,
            hasAtmosphere: true,
            atmosphereColor: 0x87ceeb,
            hasMoon: true,
            earthColors: [0x4a90e2, 0x2d5aa0, 0x228b22, 0x32cd32, 0x4169e1] // Blue and green for Earth
          },
          { 
            name: 'Mars', 
            color: 0xcd5c5c, 
            darkColor: 0x8b3a3a,
            size: 0.22, 
            distance: 7.5, 
            speed: 0.004,
            rotationSpeed: 0.02,
            hasAtmosphere: false,
            hasMoon: true,
            moonCount: 2 // Phobos and Deimos
          },
          { 
            name: 'Jupiter', 
            color: 0xd8ca9d, 
            darkColor: 0xb8a87d,
            size: 0.7, 
            distance: 10, 
            speed: 0.002,
            rotationSpeed: 0.04,
            hasAtmosphere: true,
            atmosphereColor: 0xe8dab9,
            hasMoons: true,
            moonCount: 4,
            hasStripes: true,
            stripeColors: [0xff8c42, 0xffffff, 0xd4a574] // Orange, white, sand
          },
          { 
            name: 'Saturn', 
            color: 0xf4d03f, 
            darkColor: 0xd4af37,
            size: 0.6, 
            distance: 12.5, 
            speed: 0.0015,
            rotationSpeed: 0.03,
            hasAtmosphere: true,
            atmosphereColor: 0xffe4b5,
            hasRings: true,
            hasMoons: true,
            moonCount: 2
          },
          { 
            name: 'Uranus', 
            color: 0x4fd0e7, 
            darkColor: 0x2fa0b7,
            size: 0.35, 
            distance: 15, 
            speed: 0.001,
            rotationSpeed: -0.02,
            hasAtmosphere: true,
            atmosphereColor: 0x6fe0f7
          },
          { 
            name: 'Neptune', 
            color: 0x4166f5, 
            darkColor: 0x2146d5,
            size: 0.35, 
            distance: 17.5, 
            speed: 0.0008,
            rotationSpeed: 0.025,
            hasAtmosphere: true,
            atmosphereColor: 0x6186ff
          }
        ];
        
        // Helper function to get accurate planet facts
        function getPlanetFacts(planetName) {
          const facts = {
            'Mercury': {
              description: 'The closest planet to the Sun and the smallest in our solar system. It has extreme temperature variations, ranging from 427°C during the day to -173°C at night.',
              distance: '0.39 AU',
              diameter: '4,879 km',
              orbitalPeriod: '88 Earth days',
              moons: '0',
              atmosphere: 'None'
            },
            'Venus': {
              description: 'The hottest planet in our solar system with surface temperatures around 462°C. It rotates backwards and has a thick atmosphere of carbon dioxide with clouds of sulfuric acid.',
              distance: '0.72 AU',
              diameter: '12,104 km',
              orbitalPeriod: '225 Earth days',
              moons: '0',
              atmosphere: 'Carbon dioxide, nitrogen'
            },
            'Earth': {
              description: 'Our home planet, the only known celestial body to support life. It has liquid water, a protective atmosphere, and diverse ecosystems. About 71% of its surface is covered by oceans.',
              distance: '1.00 AU',
              diameter: '12,756 km',
              orbitalPeriod: '365.25 days',
              moons: '1 (The Moon)',
              atmosphere: 'Nitrogen, oxygen'
            },
            'Mars': {
              description: 'The Red Planet, known for its iron oxide (rust) surface giving it a reddish appearance. It has polar ice caps, evidence of ancient water flows, and the largest volcano in the solar system.',
              distance: '1.52 AU',
              diameter: '6,792 km',
              orbitalPeriod: '687 Earth days',
              moons: '2 (Phobos, Deimos)',
              atmosphere: 'Carbon dioxide, nitrogen, argon'
            },
            'Jupiter': {
              description: 'The largest planet in our solar system, a gas giant with a Great Red Spot (a storm larger than Earth). It has over 80 moons and acts as a "cosmic vacuum cleaner" protecting inner planets.',
              distance: '5.20 AU',
              diameter: '142,984 km',
              orbitalPeriod: '12 Earth years',
              moons: '95+',
              atmosphere: 'Hydrogen, helium'
            },
            'Saturn': {
              description: 'Famous for its spectacular ring system made of ice and rock particles. It\'s a gas giant with a low density - it would float in water if there was an ocean large enough.',
              distance: '9.54 AU',
              diameter: '120,536 km',
              orbitalPeriod: '29 Earth years',
              moons: '146+',
              atmosphere: 'Hydrogen, helium'
            },
            'Uranus': {
              description: 'An ice giant that rotates on its side (98° tilt), likely due to an ancient collision. It has a unique blue-green color due to methane in its atmosphere absorbing red light.',
              distance: '19.19 AU',
              diameter: '51,118 km',
              orbitalPeriod: '84 Earth years',
              moons: '27',
              atmosphere: 'Hydrogen, helium, methane'
            },
            'Neptune': {
              description: 'The farthest planet from the Sun, an ice giant with the strongest winds in the solar system (up to 2,100 km/h). It appears blue due to methane in its atmosphere.',
              distance: '30.07 AU',
              diameter: '49,528 km',
              orbitalPeriod: '165 Earth years',
              moons: '16',
              atmosphere: 'Hydrogen, helium, methane'
            }
          };
          return facts[planetName] || {
            description: 'A planet in our solar system.',
            distance: 'N/A',
            diameter: 'N/A',
            orbitalPeriod: 'N/A',
            moons: 'N/A',
            atmosphere: 'N/A'
          };
        }

        // Create detailed planets
        planetData.forEach((data, index) => {
          // Higher detail geometry
          const planetGeometry = new THREE.SphereGeometry(data.size, 64, 64);
          
          // Special handling for Earth with green and blue, Jupiter with stripes
          let planetMaterial;
          if (data.name === 'Jupiter' && data.hasStripes) {
            // Create Jupiter with horizontal stripes
            const jupiterCanvas = document.createElement('canvas');
            jupiterCanvas.width = 512;
            jupiterCanvas.height = 512;
            const ctx = jupiterCanvas.getContext('2d');
            
            // Create horizontal stripes
            const stripeHeight = 512 / 12; // 12 stripes
            for (let i = 0; i < 12; i++) {
              const colorIndex = i % data.stripeColors.length;
              const stripeColor = data.stripeColors[colorIndex];
              ctx.fillStyle = `#${stripeColor.toString(16).padStart(6, '0')}`;
              ctx.fillRect(0, i * stripeHeight, 512, stripeHeight);
            }
            
            // Add some variation/blending
            const gradient = ctx.createLinearGradient(0, 0, 0, 512);
            gradient.addColorStop(0, 'rgba(255, 255, 255, 0.1)');
            gradient.addColorStop(0.5, 'rgba(255, 140, 66, 0.1)');
            gradient.addColorStop(1, 'rgba(212, 165, 116, 0.1)');
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, 512, 512);
            
            const jupiterTexture = new THREE.CanvasTexture(jupiterCanvas);
            planetMaterial = new THREE.MeshPhongMaterial({
              map: jupiterTexture,
              shininess: 30,
              specular: new THREE.Color(0x333333),
              emissive: new THREE.Color(0xd8ca9d).multiplyScalar(0.15),
              emissiveIntensity: 0.3
            });
          } else if (data.name === 'Earth' && data.earthColors) {
            // Create Earth with green continents and blue oceans
            const earthCanvas = document.createElement('canvas');
            earthCanvas.width = 512;
            earthCanvas.height = 512;
            const ctx = earthCanvas.getContext('2d');
            
            // Base blue ocean
            const oceanBlue = data.color; // 0x4a90e2
            ctx.fillStyle = `#${oceanBlue.toString(16).padStart(6, '0')}`;
            ctx.fillRect(0, 0, 512, 512);
            
            // Green colors for continents
            const forestGreen = 0x228b22;
            const limeGreen = 0x32cd32;
            const darkGreen = 0x006400;
            
            // Draw continent-like shapes (more realistic blob shapes)
            const continents = [
              { x: 100, y: 150, size: 80, color: forestGreen },
              { x: 350, y: 120, size: 70, color: limeGreen },
              { x: 200, y: 300, size: 90, color: darkGreen },
              { x: 400, y: 350, size: 60, color: forestGreen },
              { x: 150, y: 400, size: 75, color: limeGreen },
              { x: 300, y: 200, size: 55, color: darkGreen }
            ];
            
            continents.forEach(continent => {
              ctx.fillStyle = `#${continent.color.toString(16).padStart(6, '0')}`;
              ctx.beginPath();
              // Create irregular blob shape
              const points = 8;
              for (let i = 0; i < points; i++) {
                const angle = (i / points) * Math.PI * 2;
                const radius = continent.size * (0.7 + Math.random() * 0.3);
                const x = continent.x + Math.cos(angle) * radius;
                const y = continent.y + Math.sin(angle) * radius;
                if (i === 0) {
                  ctx.moveTo(x, y);
                } else {
                  ctx.lineTo(x, y);
                }
              }
              ctx.closePath();
              ctx.fill();
            });
            
            const earthTexture = new THREE.CanvasTexture(earthCanvas);
            planetMaterial = new THREE.MeshPhongMaterial({
              map: earthTexture,
              shininess: 30,
              specular: new THREE.Color(0x333333),
              emissive: new THREE.Color(0x4a90e2).multiplyScalar(0.15),
              emissiveIntensity: 0.3
            });
          } else {
            // Other planets with gradient
            planetMaterial = createGradientMaterial(data.color, data.darkColor);
            planetMaterial.shininess = 30;
            planetMaterial.specular = new THREE.Color(0x333333);
            // Add emissive for more vibrant colors
            planetMaterial.emissive = new THREE.Color(data.color).multiplyScalar(0.25);
            planetMaterial.emissiveIntensity = 0.3;
          }
          
          const planet = new THREE.Mesh(planetGeometry, planetMaterial);
          
          // Position planets in a circle around the sun
          const angle = (index / planetData.length) * Math.PI * 2;
          planet.position.x = Math.cos(angle) * data.distance;
          planet.position.z = Math.sin(angle) * data.distance;
          planet.position.y = (Math.random() - 0.5) * 1.5;
          
          // Add atmosphere if applicable
          if (data.hasAtmosphere) {
            const atmosphereGeometry = new THREE.SphereGeometry(data.size * 1.1, 32, 32);
            const atmosphereMaterial = new THREE.MeshPhongMaterial({
              color: data.atmosphereColor,
              transparent: true,
              opacity: 0.3,
              side: THREE.BackSide
            });
            const atmosphere = new THREE.Mesh(atmosphereGeometry, atmosphereMaterial);
            planet.add(atmosphere);
          }
          
          // Add rings for Saturn
          if (data.hasRings) {
            const ringGeometry = new THREE.RingGeometry(data.size * 1.2, data.size * 2, 64);
            const ringMaterial = new THREE.MeshBasicMaterial({
              color: 0xc0c0c0,
              side: THREE.DoubleSide,
              transparent: true,
              opacity: 0.7
            });
            const rings = new THREE.Mesh(ringGeometry, ringMaterial);
            rings.rotation.x = Math.PI / 2;
            planet.add(rings);
          }
          
          // Store rotation data
          planet.userData = {
            angle: angle,
            distance: data.distance,
            speed: data.speed,
            rotationSpeed: data.rotationSpeed,
            initialY: planet.position.y
          };
          
          scene.add(planet);
          planets.push(planet);
          
          // Add satellites/moons - Earth has 1 moon AND 1 satellite, Mars has 2, Jupiter/Saturn have multiple
          if (data.hasMoon && !data.moonCount) {
            // Earth - both natural moon AND satellite
            // Natural moon
            const moonGeometry = new THREE.SphereGeometry(data.size * 0.15, 16, 16);
            const moonMaterial = new THREE.MeshPhongMaterial({
              color: 0xcccccc,
              emissive: 0x888888,
              emissiveIntensity: 0.5,
              shininess: 10
            });
            const moon = new THREE.Mesh(moonGeometry, moonMaterial);
            moon.userData = {
              parentPlanet: planet,
              distance: data.size * 2.2,
              angle: Math.random() * Math.PI * 2,
              speed: data.speed * 3,
              isMoon: true,
              name: 'The Moon'
            };
            scene.add(moon);
            moons.push(moon);
            
            // Satellite
            const satellite = new THREE.Group();
            const bodySize = data.size * 0.12;
            const bodyGeometry = new THREE.BoxGeometry(bodySize, bodySize, bodySize * 1.5);
            const bodyMaterial = new THREE.MeshPhongMaterial({
              color: 0x888888,
              emissive: 0x444444,
              emissiveIntensity: 0.3,
              shininess: 30
            });
            const body = new THREE.Mesh(bodyGeometry, bodyMaterial);
            satellite.add(body);
            
            const panelSize = bodySize * 1.5;
            const panelGeometry = new THREE.BoxGeometry(panelSize, bodySize * 0.3, bodySize * 0.1);
            const panelMaterial = new THREE.MeshPhongMaterial({
              color: 0x1a1a2e,
              emissive: 0x0a0a1a,
              emissiveIntensity: 0.2,
              shininess: 50
            });
            
            const leftPanel = new THREE.Mesh(panelGeometry, panelMaterial);
            leftPanel.position.x = -panelSize / 2 - bodySize / 2;
            satellite.add(leftPanel);
            
            const rightPanel = new THREE.Mesh(panelGeometry, panelMaterial);
            rightPanel.position.x = panelSize / 2 + bodySize / 2;
            satellite.add(rightPanel);
            
            const antennaGeometry = new THREE.CylinderGeometry(bodySize * 0.05, bodySize * 0.05, bodySize * 0.8, 8);
