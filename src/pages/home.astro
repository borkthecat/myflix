      const modalStack = document.getElementById("modal-stack");
      const modalStatus = document.getElementById("modal-status");
      const modalOwner = document.getElementById("modal-owner");
      const modalHeroImage = document.getElementById("modal-hero-image");
      const modalHeroVideo = document.getElementById("modal-hero-video");
      const modalDetails = document.getElementById("modal-details");
      const visitProjectBtn = document.getElementById("visit-project-btn");
      const viewCodeBtn = document.getElementById("view-code-btn");
      const closeBtn = document.querySelector(".close");

      document.querySelectorAll(".project-card").forEach((card) => {
        card.addEventListener("click", () => {
          const p = projects[card.dataset.project];
          modalTitle.textContent = p.title;
          modalTech.textContent = p.tech;
          modalDesc.textContent = p.desc;
          modalType.textContent = p.type;
          modalStack.textContent = p.stack;
          modalStatus.textContent = p.status;
          modalStatus.classList.remove("status-live", "status-in-progress");
          if (p.status === "Live") {
            modalStatus.classList.add("status-live");
          } else if (p.status === "In Progress") {
            modalStatus.classList.add("status-in-progress");
          }
          modalOwner.textContent = p.owner;
          
          // Set visit project button URL and label
          if (visitProjectBtn) {
            const btnText = visitProjectBtn.querySelector('.btn-text') || visitProjectBtn.lastChild;
            if (p.url) {
              visitProjectBtn.href = p.url;
              visitProjectBtn.removeAttribute('onclick');
              btnText.textContent = " Visit Project";
            } else if (p.btnLabel) {
              visitProjectBtn.href = "#";
              visitProjectBtn.onclick = (e) => { e.preventDefault(); modalDetails.scrollIntoView({ behavior: 'smooth' }); };
              btnText.textContent = ` ${p.btnLabel}`;
            } else {
              visitProjectBtn.href = "#";
              visitProjectBtn.removeAttribute('onclick');
              btnText.textContent = " Visit Project";
            }
          }

          // Set view code button URL
          if (viewCodeBtn) {
            if (p.github) {
              viewCodeBtn.href = p.github;
              viewCodeBtn.style.display = "inline-flex";
            } else {
              viewCodeBtn.href = "#";
              viewCodeBtn.style.display = "none";
            }
          }

          // Set details section
          if (modalDetails) {
            if (p.details) {
              modalDetails.innerHTML = p.details;
              modalDetails.style.display = "block";
            } else {
              modalDetails.innerHTML = "";
              modalDetails.style.display = "none";
            }
          }
          
          // Set hero image or video
          const modalHeroContainer = document.querySelector('.modal-hero');
          if (p.video && modalHeroVideo) {
            modalHeroVideo.src = p.video;
            modalHeroVideo.style.display = "block";
            modalHeroVideo.play();
            if (modalHeroImage) modalHeroImage.style.display = "none";
            if (modalHeroContainer) modalHeroContainer.classList.add('modal-hero-video-active');
          } else {
            if (modalHeroVideo) {
              modalHeroVideo.pause();
              modalHeroVideo.src = "";
              modalHeroVideo.style.display = "none";
            }
            if (modalHeroContainer) modalHeroContainer.classList.remove('modal-hero-video-active');
            if (modalHeroImage) {
              modalHeroImage.style.display = "block";
              if (p.image) {
                modalHeroImage.style.backgroundImage = `url(${p.image})`;
                modalHeroImage.style.backgroundSize = "cover";
                modalHeroImage.style.backgroundPosition = "center";
              } else {
                modalHeroImage.style.background = 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
              }
            }
          }
          
          modal.style.display = "flex";
        });
      });

      function closeModal() {
        modal.style.display = "none";
        if (modalHeroVideo) { modalHeroVideo.pause(); modalHeroVideo.src = ""; }
      }
      closeBtn.addEventListener("click", closeModal);
      window.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });

      // Skills popup functionality
      const popupOverlay = document.getElementById("popup-overlay");
      const skillItems = document.querySelectorAll(".top10-item-grid");
      let activePopup = null;

      skillItems.forEach((item) => {
        const poster = item.querySelector(".top10-poster");
        const popup = item.querySelector(".top10-popup");
        const closeBtn = popup.querySelector(".popup-close");

        poster.addEventListener("click", (e) => {
          e.stopPropagation();
          
          // Close any active popup
          if (activePopup) {
            activePopup.classList.remove("active");
            document.querySelector(".top10-item-grid.active")?.classList.remove("active");
          }
          
          // Open this popup
          item.classList.add("active");
          popup.classList.add("active");
          popupOverlay.classList.add("active");
          activePopup = popup;
        });

        closeBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          closePopup();
        });
      });

      popupOverlay.addEventListener("click", () => {
        closePopup();
      });

      function closePopup() {
        if (activePopup) {
          activePopup.classList.remove("active");
          document.querySelector(".top10-item-grid.active")?.classList.remove("active");
          popupOverlay.classList.remove("active");
          activePopup = null;
        }
      }

      // Close on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && activePopup) {
          closePopup();
        }
      });

      // Solar System Info Modal
      const solarInfoIcon = document.getElementById("solar-info-icon");
      const solarInfoModal = document.getElementById("solar-info-modal");
      const solarInfoClose = document.querySelector(".solar-info-close");
      const solarInfoOverlay = document.querySelector(".solar-info-overlay");

      if (solarInfoIcon) {
        solarInfoIcon.addEventListener("click", () => {
          solarInfoModal.classList.add("active");
        });
      }

      if (solarInfoClose) {
        solarInfoClose.addEventListener("click", () => {
          solarInfoModal.classList.remove("active");
        });
      }

      if (solarInfoOverlay) {
        solarInfoOverlay.addEventListener("click", () => {
          solarInfoModal.classList.remove("active");
        });
      }

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && solarInfoModal.classList.contains("active")) {
          solarInfoModal.classList.remove("active");
        }
      });

      // Planet Information Modal
      const planetInfoModal = document.getElementById("planet-info-modal");
      const planetInfoClose = document.querySelector(".planet-info-close");
      const planetInfoOverlay = document.querySelector(".planet-info-overlay");

      function closePlanetModal() {
        if (planetInfoModal) {
          planetInfoModal.style.display = "none";
        }
      }

      if (planetInfoClose) {
        planetInfoClose.addEventListener("click", closePlanetModal);
      }

      if (planetInfoOverlay) {
        planetInfoOverlay.addEventListener("click", closePlanetModal);
      }

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && planetInfoModal && planetInfoModal.style.display === "flex") {
          closePlanetModal();
        }
      });

      document.addEventListener("DOMContentLoaded", () => {
        const browseMenu = document.querySelector(".browse-menu");
        const browseBtn = document.querySelector(".browse-btn");

        browseBtn.addEventListener("click", () => {
          browseMenu.classList.toggle("active");
        });

        // Close if clicked outside
        document.addEventListener("click", (e) => {
          if (!browseMenu.contains(e.target)) {
            browseMenu.classList.remove("active");
          }
        });
      });
    </script>
  </body>
</html>
