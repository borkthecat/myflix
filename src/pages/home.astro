    <!-- Modal -->
    <div class="modal" id="modal">
      <div class="modal-content">
        <button class="close">&times;</button>
        
        <!-- Hero Image Section -->
        <div class="modal-hero">
          <div class="modal-hero-image" id="modal-hero-image"></div>
          <div class="modal-hero-overlay"></div>
        </div>

        <!-- Content Section -->
        <div class="modal-body">
          <div class="modal-header">
            <h2 class="modal-title" id="modal-title"></h2>
            <p class="modal-tech" id="modal-tech"></p>
          </div>

          <div class="modal-actions">
            <button class="btn btn-primary">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7z"/>
              </svg>
              Visit Project
            </button>
            <button class="btn btn-secondary">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
              </svg>
              View Code
            </button>
            <button class="btn btn-icon" aria-label="Add to list">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
          </div>

          <p class="modal-desc" id="modal-desc"></p>

          <div class="modal-info">
            <div class="info-item">
              <span class="info-label">Type</span>
              <span class="info-value" id="modal-type"></span>
            </div>
            <div class="info-item">
              <span class="info-label">Stack</span>
              <span class="info-value" id="modal-stack"></span>
            </div>
            <div class="info-item info-item-status">
              <span class="info-label">Status</span>
              <span class="info-value status-badge" id="modal-status"></span>
            </div>
            <div class="info-item">
              <span class="info-label">Owner</span>
              <span class="info-value" id="modal-owner"></span>
            </div>
          </div>
        </div>
