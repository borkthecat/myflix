      if (solarInfoOverlay) {
        solarInfoOverlay.addEventListener("click", () => {
          solarInfoModal.classList.remove("active");
        });
      }

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && solarInfoModal.classList.contains("active")) {
          solarInfoModal.classList.remove("active");
