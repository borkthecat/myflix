    <script>
      // Smooth scroll with navbar offset
      document.querySelectorAll('.nav-links a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const targetId = this.getAttribute('href');
          if (targetId === '#') return;
          
          const targetElement = document.querySelector(targetId);
          if (targetElement) {
            const navbarHeight = 70;
            const targetPosition = targetElement.offsetTop - navbarHeight;
            
            window.scrollTo({
              top: targetPosition,
              behavior: 'smooth'
            });
          }
        });
      });

      // Navbar scroll effect
      window.addEventListener("scroll", () => {
        const navbar = document.querySelector(".navbar");
        if (window.scrollY > 50) {
          navbar.classList.add("scrolled");
        } else {
          navbar.classList.remove("scrolled");
        }
      });

      // Avatar switching
      const userAvatars = {
        user1: "/images/user1.jpg",
        user2: "/images/user2.jpg",
        user3: "/images/user3.jpg",
        user4: "/images/user4.jpg",
      };

      const params = new URLSearchParams(window.location.search);
      let user =
        params.get("user") || localStorage.getItem("selectedUser") || "user1";
      localStorage.setItem("selectedUser", user);

      const avatarEl = document.querySelector(".avatar");
      if (avatarEl && userAvatars[user]) {
        avatarEl.src = userAvatars[user];
      }

      // Search toggle
      const searchWrapper = document.querySelector(".search-wrapper");
      const searchToggle = document.querySelector(".search-toggle");
      const searchInput = document.querySelector(".search-input");

      searchToggle.addEventListener("click", () => {
        searchWrapper.classList.toggle("active");
        if (searchWrapper.classList.contains("active")) {
          searchInput.focus();
        }
      });

      // Collapse search when clicking outside
      document.addEventListener("click", (e) => {
        if (!searchWrapper.contains(e.target)) {
          searchWrapper.classList.remove("active");
        }
      });
      const projects = {
        p1: {
          title: "Project 1",
          tech: "Python • OpenAI • Whisper",
          desc: "A cutting-edge AI-powered application that leverages OpenAI's advanced models and Whisper for speech recognition. This project demonstrates the integration of modern AI technologies to create intelligent, responsive systems that can understand and process natural language with remarkable accuracy.",
          type: "AI Application",
          stack: "Python, OpenAI, Whisper",
          status: "Live",
          owner: "Your Name",
          heroImage: "linear-gradient(135deg, #667eea 0%, #764ba2 100%)",
        },
        p2: {
          title: "Project 2",
          tech: "Next.js • TypeScript",
          desc: "A modern web application built with Next.js and TypeScript, featuring server-side rendering, optimized performance, and type-safe development. This project showcases best practices in React development and demonstrates scalable architecture for production-ready applications.",
          type: "Web Application",
          stack: "Next.js, TypeScript",
          status: "Beta",
          owner: "Your Name",
          heroImage: "linear-gradient(135deg, #f093fb 0%, #f5576c 100%)",
        },
        p3: {
          title: "Project 3",
          tech: "React • Tailwind",
          desc: "A beautifully designed user interface built with React and Tailwind CSS. This project focuses on creating responsive, accessible, and visually stunning components that provide an exceptional user experience across all devices and screen sizes.",
          type: "UI/UX Project",
          stack: "React, Tailwind",
          status: "Live",
          owner: "Your Name",
          heroImage: "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)",
        },
        p4: {
          title: "Project 4",
          tech: "Python • PyTorch",
          desc: "An advanced machine learning project utilizing PyTorch for deep learning model development. This project explores neural network architectures, training methodologies, and model optimization techniques to solve complex computational problems.",
          type: "Machine Learning",
          stack: "Python, PyTorch",
          status: "In Progress",
          owner: "Your Name",
          heroImage: "linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)",
        },
        p5: {
          title: "Project 5",
          tech: "Data Science • LLM",
          desc: "A comprehensive data science project that incorporates Large Language Models for advanced analytics and insights. This project demonstrates the power of combining traditional data science techniques with modern AI capabilities to extract meaningful patterns and predictions from complex datasets.",
          type: "Data Science",
          stack: "Python, Pandas, LLM",
          status: "In Progress",
          owner: "Your Name",
          heroImage: "linear-gradient(135deg, #fa709a 0%, #fee140 100%)",
        },
      };

      const modal = document.getElementById("modal");
      const modalTitle = document.getElementById("modal-title");
      const modalTech = document.getElementById("modal-tech");
      const modalDesc = document.getElementById("modal-desc");
      const modalType = document.getElementById("modal-type");
      const modalStack = document.getElementById("modal-stack");
      const modalStatus = document.getElementById("modal-status");
      const modalOwner = document.getElementById("modal-owner");
      const modalHeroImage = document.getElementById("modal-hero-image");
      const closeBtn = document.querySelector(".close");

      const openProjectModal = (projectId) => {
        const p = projects[projectId];
        if (!p) return;
        
        modalTitle.textContent = p.title;
        modalTech.textContent = p.tech;
        modalDesc.textContent = p.desc;
        modalType.textContent = p.type;
        modalStack.textContent = p.stack;
        modalStatus.textContent = p.status;
        modalOwner.textContent = p.owner;
        
        // Set status badge class
        const statusLower = p.status.toLowerCase().replace(/\s+/g, '-');
        modalStatus.className = `info-value status-badge ${statusLower}`;
        
        // Set hero image background
        if (modalHeroImage && p.heroImage) {
          modalHeroImage.style.background = p.heroImage;
        }
        
        modal.style.display = "flex";
        document.body.style.overflow = "hidden"; // Prevent background scrolling
      };

      document.querySelectorAll(".project-card").forEach((card) => {
        card.addEventListener("click", () => {
          openProjectModal(card.dataset.project);
        });
      });

      // Make row items clickable
      document.querySelectorAll(".row-item[data-project]").forEach((item) => {
        item.addEventListener("click", () => {
          openProjectModal(item.dataset.project);
        });
      });

      const closeModal = () => {
        modal.style.display = "none";
        document.body.style.overflow = ""; // Restore scrolling
      };

      closeBtn.addEventListener("click", closeModal);
      window.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });

      // Close modal on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && modal.style.display === "flex") {
          closeModal();
        }
      });

      document.addEventListener("DOMContentLoaded", () => {
        const browseMenu = document.querySelector(".browse-menu");
        const browseBtn = document.querySelector(".browse-btn");

        browseBtn.addEventListener("click", () => {
          browseMenu.classList.toggle("active");
        });

        // Close if clicked outside
        document.addEventListener("click", (e) => {
          if (!browseMenu.contains(e.target)) {
            browseMenu.classList.remove("active");
          }
        });
      });
