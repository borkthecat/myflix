      closeBtn.addEventListener("click", () => (modal.style.display = "none"));
      window.addEventListener("click", (e) => {
        if (e.target === modal) modal.style.display = "none";
      });

      // Skills popup functionality
      const popupOverlay = document.getElementById("popup-overlay");
      const skillItems = document.querySelectorAll(".top10-item-grid");
      let activePopup = null;

      skillItems.forEach((item) => {
        const poster = item.querySelector(".top10-poster");
        const popup = item.querySelector(".top10-popup");
        const closeBtn = popup.querySelector(".popup-close");

        poster.addEventListener("click", (e) => {
          e.stopPropagation();
          
          // Close any active popup
          if (activePopup) {
            activePopup.classList.remove("active");
            document.querySelector(".top10-item-grid.active")?.classList.remove("active");
          }
          
          // Open this popup
          item.classList.add("active");
          popup.classList.add("active");
          popupOverlay.classList.add("active");
          activePopup = popup;
        });

        closeBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          closePopup();
        });
      });

      popupOverlay.addEventListener("click", () => {
        closePopup();
      });

      function closePopup() {
        if (activePopup) {
          activePopup.classList.remove("active");
          document.querySelector(".top10-item-grid.active")?.classList.remove("active");
          popupOverlay.classList.remove("active");
          activePopup = null;
        }
      }

      // Close on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && activePopup) {
          closePopup();
