          modalTech.textContent = p.tech;
          modalDesc.textContent = p.desc;
          modalType.textContent = p.type;
          modalStack.textContent = p.stack;
          modalStatus.textContent = p.status;
          if (p.status === "Live") {
            modalStatus.classList.add("status-live");
          } else {
            modalStatus.classList.remove("status-live");
          }
          modalOwner.textContent = p.owner;
          
          // Set visit project button URL
          if (visitProjectBtn && p.url) {
            visitProjectBtn.href = p.url;
          } else if (visitProjectBtn) {
            visitProjectBtn.href = "#";
          }
          
          // Set hero image background
          if (modalHeroImage && p.image) {
            modalHeroImage.style.backgroundImage = `url(${p.image})`;
            modalHeroImage.style.backgroundSize = "cover";
            modalHeroImage.style.backgroundPosition = "center";
          } else if (modalHeroImage) {
            modalHeroImage.style.background = 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)';
          }
          
          modal.style.display = "flex";
        });
      });

      closeBtn.addEventListener("click", () => (modal.style.display = "none"));
      window.addEventListener("click", (e) => {
        if (e.target === modal) modal.style.display = "none";
      });

      // Skills popup functionality
      const popupOverlay = document.getElementById("popup-overlay");
      const skillItems = document.querySelectorAll(".top10-item-grid");
      let activePopup = null;

      skillItems.forEach((item) => {
        const poster = item.querySelector(".top10-poster");
        const popup = item.querySelector(".top10-popup");
        const closeBtn = popup.querySelector(".popup-close");

        poster.addEventListener("click", (e) => {
          e.stopPropagation();
          
          // Close any active popup
          if (activePopup) {
            activePopup.classList.remove("active");
            document.querySelector(".top10-item-grid.active")?.classList.remove("active");
          }
          
          // Open this popup
          item.classList.add("active");
          popup.classList.add("active");
          popupOverlay.classList.add("active");
          activePopup = popup;
        });

        closeBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          closePopup();
        });
      });

      popupOverlay.addEventListener("click", () => {
        closePopup();
      });

      function closePopup() {
        if (activePopup) {
          activePopup.classList.remove("active");
          document.querySelector(".top10-item-grid.active")?.classList.remove("active");
          popupOverlay.classList.remove("active");
          activePopup = null;
        }
      }

      // Close on Escape key
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && activePopup) {
          closePopup();
        }
      });

      document.addEventListener("DOMContentLoaded", () => {
        const browseMenu = document.querySelector(".browse-menu");
        const browseBtn = document.querySelector(".browse-btn");

        browseBtn.addEventListener("click", () => {
          browseMenu.classList.toggle("active");
        });

        // Close if clicked outside
        document.addEventListener("click", (e) => {
          if (!browseMenu.contains(e.target)) {
            browseMenu.classList.remove("active");
          }
        });
      });
    </script>
