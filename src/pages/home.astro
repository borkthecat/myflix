    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://threejs.org/examples/js/loaders/GLTFLoader.js"></script>
    <script>
      // Auto year update
      document.getElementById("year").textContent = new Date().getFullYear();

      // Interactive 3D Globe with Three.js
      function initGlobe() {
        const canvas = document.getElementById('globe-canvas');
        if (!canvas) {
          console.error('Canvas not found');
          return;
        }
        
        if (typeof THREE === 'undefined') {
          console.error('Three.js not loaded');
          setTimeout(initGlobe, 100);
          return;
        }
        
        const scene = new THREE.Scene();
        
        // Get canvas dimensions
        const getSize = () => {
          const rect = canvas.getBoundingClientRect();
          return {
            width: rect.width || 800,
            height: rect.height || 600
          };
        };
        
        let { width, height } = getSize();
        console.log('Initial canvas size:', width, height);
        
        // Ensure minimum dimensions - use parent container size
        const wrapper = canvas.parentElement;
        if (width === 0 || height === 0) {
          const rect = wrapper ? wrapper.getBoundingClientRect() : { width: 800, height: 600 };
          width = rect.width || 800;
          height = rect.height || 600;
          console.log('Using wrapper size:', width, height);
        }
        
        // Set canvas dimensions explicitly
        canvas.width = width;
        canvas.height = height;
        canvas.style.width = width + 'px';
        canvas.style.height = height + 'px';
        
        const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ 
          canvas: canvas, 
          alpha: true, 
          antialias: true
        });
        
        renderer.setSize(width, height, false);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.setClearColor(0x000000, 0);
        
        // Make canvas visible and ensure it's on top
        canvas.style.display = 'block';
        canvas.style.visibility = 'visible';
        canvas.style.opacity = '1';
        canvas.style.position = 'relative';
        canvas.style.zIndex = '10';
        console.log('Canvas dimensions set:', canvas.width, canvas.height);
        
        // Load voxel model ONLY
        console.log('Loading voxel model...');
        
        let earth;
        let continents = [];
        
        // Check if GLTFLoader is available
        if (typeof THREE !== 'undefined' && typeof THREE.GLTFLoader !== 'undefined') {
          const loader = new THREE.GLTFLoader();
          
          loader.load(
            '/voxel_arcade_packman.glb',
            (gltf) => {
              console.log('Voxel model loaded successfully');
              earth = gltf.scene;
              
              // Scale the model appropriately
              earth.scale.set(6, 6, 6);
              
              // Center the model
              const box = new THREE.Box3().setFromObject(earth);
              const center = box.getCenter(new THREE.Vector3());
              if (earth.position) {
                earth.position.sub(center);
              }
              
              scene.add(earth);
              console.log('Voxel model added to scene');
              
              // Store for rotation
              continents = [earth];
            },
            (progress) => {
              console.log('Loading progress:', (progress.loaded / progress.total * 100) + '%');
            },
            (error) => {
              console.error('Error loading voxel model:', error);
            }
          );
        } else {
          console.error('GLTFLoader not available');
        }
        
        // Add extensive stars background that covers ENTIRE hero section (behind text too)
        const starsGeometry = new THREE.BufferGeometry();
        const starsMaterial = new THREE.PointsMaterial({
          color: 0xffffff,
          size: 1.5,
          transparent: true,
          opacity: 0.9
        });
        const starsVertices = [];
        // Create stars in a much larger area to cover entire hero section including behind text
        // Position stars to cover the full width and height of hero section
        const heroSection = document.querySelector('.hero');
        const heroWidth = heroSection ? heroSection.offsetWidth : window.innerWidth;
        const heroHeight = heroSection ? heroSection.offsetHeight : window.innerHeight;
        
        for (let i = 0; i < 30000; i++) {
          // Spread stars across entire hero section width and height
          const x = (Math.random() - 0.5) * heroWidth * 2;
          const y = (Math.random() - 0.5) * heroHeight * 2;
          const z = (Math.random() - 0.5) * 5000; // Deep space
          starsVertices.push(x, y, z);
        }
        starsGeometry.setAttribute('position', new THREE.Float32BufferAttribute(starsVertices, 3));
        const stars = new THREE.Points(starsGeometry, starsMaterial);
        scene.add(stars);
        console.log('Extended stars background added across entire hero');
        
        // Add vibrant, warm lighting (like sunlight)
        const ambientLight = new THREE.AmbientLight(0xffffff, 1.5);
        scene.add(ambientLight);
        console.log('Ambient light added');
        
        // Main sunlight (warm yellow)
        const directionalLight = new THREE.DirectionalLight(0xfff8dc, 2);
        directionalLight.position.set(5, 5, 5);
        scene.add(directionalLight);
        console.log('Sunlight added');
        
        // Secondary warm light
        const pointLight = new THREE.PointLight(0xffebcd, 1.2);
        pointLight.position.set(-5, 0, 5);
        scene.add(pointLight);
        
        // Rim light for depth
        const rimLight = new THREE.DirectionalLight(0x87ceeb, 0.8);
        rimLight.position.set(-5, -3, -5);
        scene.add(rimLight);
        console.log('Vibrant lighting added');
        
        // Position camera closer for better visibility
        camera.position.z = 14;
        camera.position.y = 1.5;
        camera.position.x = 0;
        camera.lookAt(0, 0, 0);
        console.log('Camera positioned');
        
        // Store initial positions for parallax
        const initialZ = camera.position.z;
        const initialY = camera.position.y;
        const initialX = camera.position.x;
        
        // Draggable interaction
        let isDragging = false;
        let previousMousePosition = { x: 0, y: 0 };
        let rotationSpeed = { x: 0, y: 0 };
        
        canvas.addEventListener('mousedown', (e) => {
          isDragging = true;
          previousMousePosition = { x: e.clientX, y: e.clientY };
          canvas.style.cursor = 'grabbing';
        });
        
        canvas.addEventListener('mousemove', (e) => {
          if (isDragging) {
            const deltaX = e.clientX - previousMousePosition.x;
            const deltaY = e.clientY - previousMousePosition.y;
            
            // Fix rotation direction for touch too
            rotationSpeed.y = -deltaX * 0.01;
            rotationSpeed.x = deltaY * 0.01;
            
            if (earth) {
              earth.rotation.y += rotationSpeed.y;
              earth.rotation.x += rotationSpeed.x;
              if (continents) {
                continents.forEach(cont => {
                  if (cont && cont !== earth) {
                    cont.rotation.y += rotationSpeed.y;
                    cont.rotation.x += rotationSpeed.x;
                  }
                });
              }
              
              // Limit vertical rotation
              earth.rotation.x = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, earth.rotation.x));
              if (continents) {
                continents.forEach(cont => {
                  if (cont && cont !== earth) {
                    cont.rotation.x = earth.rotation.x;
                  }
                });
              }
            }
            
            previousMousePosition = { x: e.clientX, y: e.clientY };
          }
        });
        
        canvas.addEventListener('mouseup', () => {
          isDragging = false;
          canvas.style.cursor = 'grab';
        });
        
        canvas.addEventListener('mouseleave', () => {
          isDragging = false;
          canvas.style.cursor = 'grab';
        });
        
        // Touch support
        let touchStart = { x: 0, y: 0 };
        
        canvas.addEventListener('touchstart', (e) => {
          e.preventDefault();
          isDragging = true;
          touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
        });
        
        canvas.addEventListener('touchmove', (e) => {
          e.preventDefault();
          if (isDragging) {
            const deltaX = e.touches[0].clientX - touchStart.x;
            const deltaY = e.touches[0].clientY - touchStart.y;
            
            // Fix rotation direction for touch too
            rotationSpeed.y = -deltaX * 0.01;
            rotationSpeed.x = deltaY * 0.01;
            
            if (earth && earth.rotation) {
              earth.rotation.y += rotationSpeed.y;
              earth.rotation.x += rotationSpeed.x;
              
              earth.rotation.x = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, earth.rotation.x));
              
              if (continents && Array.isArray(continents)) {
                continents.forEach(cont => {
                  if (cont && cont.rotation && cont !== earth) {
                    cont.rotation.y += rotationSpeed.y;
                    cont.rotation.x += rotationSpeed.x;
                    cont.rotation.x = earth.rotation.x;
                  }
                });
              }
            }
            
            touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
          }
        });
        
        canvas.addEventListener('touchend', () => {
          isDragging = false;
        });
        
        // Momentum/inertia
        function applyMomentum() {
          if (!isDragging) {
            rotationSpeed.y *= 0.95;
            rotationSpeed.x *= 0.95;
            
            if (earth && earth.rotation) {
              earth.rotation.y += rotationSpeed.y;
              earth.rotation.x += rotationSpeed.x;
              
              earth.rotation.x = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, earth.rotation.x));
              
              if (continents && Array.isArray(continents)) {
                continents.forEach(cont => {
                  if (cont && cont.rotation && cont !== earth) {
                    cont.rotation.y += rotationSpeed.y;
                    cont.rotation.x += rotationSpeed.x;
                    cont.rotation.x = earth.rotation.x;
                  }
                });
              }
            }
            
            if (Math.abs(rotationSpeed.y) < 0.001 && Math.abs(rotationSpeed.x) < 0.001) {
              rotationSpeed = { x: 0, y: 0 };
            }
          }
        }
        
        // Animation loop
        function animate() {
          requestAnimationFrame(animate);
          
          // Apply momentum
          applyMomentum();
          
          // Auto-rotate when not dragging (natural direction)
          if (earth && earth.rotation && !isDragging && Math.abs(rotationSpeed.y) < 0.01 && Math.abs(rotationSpeed.x) < 0.01) {
            earth.rotation.y -= 0.002; // Negative for natural rotation
            if (continents && continents.length > 0) {
              continents.forEach(cont => {
                if (cont && cont !== earth && cont.rotation) {
                  cont.rotation.y -= 0.002;
                }
              });
            }
          }
          
          // Rotate other elements slightly faster for effect
          if (continents && continents.length > 0) {
            continents.forEach(cont => {
              if (cont && cont !== earth && cont.rotation) {
                cont.rotation.y -= 0.0001; // Negative for natural rotation
              }
            });
          }
          
          // Parallax effect - globe scrolls down with page
          const heroSection = document.querySelector('.hero');
          if (heroSection) {
            const rect = heroSection.getBoundingClientRect();
            const scrollY = window.scrollY;
            const heroHeight = heroSection.offsetHeight;
            
            // Move globe down as user scrolls (parallax scroll)
            const scrollOffset = scrollY * 0.5; // Adjust speed of parallax
            const wrapper = canvas.parentElement;
            if (wrapper) {
              wrapper.style.transform = `translateY(${scrollOffset}px)`;
            }
            
            // Also move camera slightly for depth effect
            const scrollProgress = Math.max(0, Math.min(1, scrollY / (heroHeight * 2)));
            camera.position.z = initialZ + (scrollProgress * 5);
            camera.position.y = initialY + (scrollProgress * 2);
          }
          
          renderer.render(scene, camera);
        }
        
        // Handle window resize
        window.addEventListener('resize', () => {
          const { width, height } = getSize();
          renderer.setSize(width, height);
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
        });
        
        // Test: Render a simple colored rectangle first to verify canvas works
        const testGeometry = new THREE.BoxGeometry(2, 2, 2);
        const testMaterial = new THREE.MeshBasicMaterial({ color: 0xff0000 });
        const testCube = new THREE.Mesh(testGeometry, testMaterial);
        scene.add(testCube);
        renderer.render(scene, camera);
        console.log('Test cube rendered - you should see a red cube if canvas works');
        
        // Remove test cube and render globe
        scene.remove(testCube);
        
        // Force initial render multiple times to ensure visibility
        console.log('Starting render loop...');
        console.log('Canvas element:', canvas);
        console.log('Canvas computed style:', window.getComputedStyle(canvas));
        console.log('Canvas bounding rect:', canvas.getBoundingClientRect());
        
        renderer.render(scene, camera);
        renderer.render(scene, camera);
        renderer.render(scene, camera);
        
        // Verify scene has objects
        console.log('Scene children count:', scene.children.length);
        console.log('Camera position:', camera.position);
        console.log('Renderer size:', renderer.getSize());
        console.log('Earth position:', earth.position);
        console.log('Earth visible:', earth.visible);
        
        // Check if canvas is actually visible
        const rect = canvas.getBoundingClientRect();
        console.log('Canvas bounding rect:', rect);
        if (rect.width === 0 || rect.height === 0) {
          console.error('Canvas has zero dimensions!');
        }
        
        // Start animation
        animate();
        console.log('Animation started');
        
        // Hide hint after interaction
        const hint = document.querySelector('.globe-hint');
        let hasInteracted = false;
        const hideHint = () => {
          if (!hasInteracted && hint) {
            hasInteracted = true;
            hint.style.transition = 'opacity 0.3s ease';
            hint.style.opacity = '0';
            setTimeout(() => hint.style.display = 'none', 300);
          }
        };
        
        canvas.addEventListener('mousedown', hideHint);
        canvas.addEventListener('touchstart', hideHint);
      }
      
      // Initialize when DOM and Three.js are ready
      function waitForThree() {
        if (typeof THREE !== 'undefined') {
          setTimeout(initGlobe, 100);
        } else {
          setTimeout(waitForThree, 100);
        }
      }
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', waitForThree);
      } else {
        waitForThree();
      }
    </script>

